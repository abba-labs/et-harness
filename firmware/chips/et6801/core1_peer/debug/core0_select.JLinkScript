__constant U32 ET_CORE0_AHB_AP_INDEX = 1;

/* Select Core0 through AP1 without reading or writing target registers. */
void ConfigTargetSettings(void)
{
    JLINK_SYS_Report("ET6801 Core0 selected through AHB-AP[1]");
    JLINK_CORESIGHT_AddAP(0, CORESIGHT_APB_AP);
    JLINK_CORESIGHT_AddAP(1, CORESIGHT_AHB_AP);
    JLINK_CORESIGHT_AddAP(2, CORESIGHT_AHB_AP);
    JLINK_CORESIGHT_AddAP(3, CORESIGHT_APB_AP);
    JLINK_CORESIGHT_IndexAHBAPToUse = ET_CORE0_AHB_AP_INDEX;
    JLINK_CPU = CORTEX_M7;
}
