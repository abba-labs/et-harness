      "[RESULT] case=dualcore_smoke status=PASS",
      "[OBSERVE] failure_count=0x00000000"
    ]
  },
  "cores": [
    {
      "id": "core0",
      "role": "launcher",
      "build_manifest": "firmware/chips/et6801/project.yaml",
      "project": "firmware/build/et6801/ET6801_Automated_Test.uvprojx",
      "target": "ET6801_SILICON_CORE1_LAUNCHER_FLASH",
