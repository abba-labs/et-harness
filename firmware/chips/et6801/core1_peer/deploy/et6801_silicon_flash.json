      "output_axf": "firmware/build/et6801/core1_peer/Objects/CORE1_PFLASH1_PEER/et6801_core1_pflash1_peer.axf",
      "output_bin": "firmware/build/et6801/core1_peer/et6801_core1_pflash1_peer.bin",
      "load_address": "0x08080000",
      "code_limit": "0x08100000",
      "stack_low": "0x20000000",
      "stack_high": "0x20020000",
