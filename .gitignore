# Python and test caches
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.venv/
*.egg-info/

# Harness dependency and build directories
node_modules/
.vite/
coverage/

# IDE, OS, and FPGA simulation state
.vs/
.vscode/
.Xil/
xsim.dir/
vivado*.jou
vivado*.log
*.jou
*.log
*.dmp
Thumbs.db
.DS_Store
~$*.xlsx

# Keil and firmware build products; keep project/configuration files
firmware/build/*/Objects/
firmware/build/*/Listings/
firmware/build/*/*.o
firmware/build/*/*.d
firmware/build/*/*.dep
firmware/build/*/*.axf
firmware/build/*/*.hex
firmware/build/*/*.bin
firmware/build/*/*.map
firmware/build/*/*.htm
firmware/build/*/*.lnp
firmware/build/*/*.lst
firmware/build/*/*.json
firmware/build/*/*.txt
firmware/build/*/*.ini
firmware/build/*/*.uvoptx
firmware/build/*/*.uvguix.*

# Operator-local configuration and generated output
run_config.yaml

# Runtime facts and legacy evidence stay local; add reviewed Case Markdown/attachments with exact git add -f paths.
artifacts/runs/**
artifacts/reports/**
artifacts/records/**
!artifacts/runs/.gitkeep
!artifacts/reports/.gitkeep

# Local tool output
tmp/
report/runs/
project-governance/runtime/
