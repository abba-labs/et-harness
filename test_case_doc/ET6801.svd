                <register>
                    <name>ecc_intf1_status</name>
                    <description>Describe the details of the register: ecc_intf1_status</description>
                    <addressOffset>0x0400</addressOffset>
                    <size>32</size>
                    <access>
                        read-write 
                    </access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0xFFFFFFFC</resetMask>
                    <fields>
                        

                        <field>
                            <name>ecc_read</name>
                            <description> Read flags for ECC blocks. Indicates whether the stored ECC value for each block has been read from memory0 = not read1 = read. </description>
                            <bitOffset>25</bitOffset>
                            <bitWidth>5</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>ecc_can_correct</name>
                            <description> Correctable flag for each ECC block. Indicates if the detected error is correctablea:0 = not correctable1 = correctable.See Table 2-33 on SMC databook page 2-48 for the decoding information of the ecc_can_correct flag and ecc_fail flag. </description>
                            <bitOffset>20</bitOffset>
                            <bitWidth>5</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>ecc_fail</name>
                            <description> Pass, fail flag for each ECC block:0 = pass1 = fail.See Table 2-33 on SMC databook page 2-48 for the decoding information of the ecc_can_correct flag and ecc_fail flag. </description>
                            <bitOffset>15</bitOffset>
                            <bitWidth>5</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>ecc_value_valid</name>
                            <description> Valid flag for each ECC block. </description>
                            <bitOffset>10</bitOffset>
                            <bitWidth>5</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>ecc_rd_n_wr</name>
                            <description> 0 = write1 = read. </description>
                            <bitOffset>9</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>ecc_last_status</name>
                            <description> b00 = Completed successfullyb01 = Unaligned address, or out-of-rangeb10 = Data stop after incomplete blockb11 = Data stopped but values not read/written because of ecc_jump value.Note The ecc_last_status bit is only updated at the completion of an ECC calculation. </description>
                            <bitOffset>7</bitOffset>
                            <bitWidth>2</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>ecc_status</name>
                            <description> Provides the status of the ECC block:0 = idle1 = busy. </description>
                            <bitOffset>6</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>ecc_int_status</name>
                            <description> The interrupts are:【5】Abort.【4】Extra block (if used).【3】Block 3.【2】Block 2.【1】Block 1.【0】Block 0.NoteTo clear an interrupt, write a 1 to the appropriate bit. </description>
                            <bitOffset>0</bitOffset>
                            <bitWidth>6</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                    </fields>
                </register>
                 


                <register>
                    <name>ecc_intf1_cfg</name>
                    <description>Describe the details of the register: ecc_intf1_cfg</description>
                    <addressOffset>0x0404</addressOffset>
                    <size>32</size>
                    <access>
                        read-write 
                    </access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0xFFF80000</resetMask>
                    <fields>
                        

                        <field>
                            <name>ecc_extra_block_size</name>
                            <description> The size of the extra block in memory after the last 512-byte block:b00 = 4 bytesb01 = 8 bytesb10 = 16 bytesb11 = 32 bytes.Note These bits are only present if you configure the SMC to use the ECC Extra Block Enable option. See the CoreLink SMC-35x AXI Static Memory Controller Series Supplement to AMBA Designer (FD001) User Guide for information about enabling this option. </description>
                            <bitOffset>11</bitOffset>
                            <bitWidth>2</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>ecc_extra_block</name>
                            <description> If configured, this enables a small block for extra information after the last 512 bytes block in the page.Note These bits are only present if the ECC Extra Block Enable option is configured. </description>
                            <bitOffset>10</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>ecc_int_abort</name>
                            <description> Interrupt on ECC abort. </description>
                            <bitOffset>9</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>ecc_int_pass</name>
                            <description> Interrupt when a correct ECC value is read from memory. </description>
                            <bitOffset>8</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>ecc_ignore_add_eight</name>
                            <description> This bit is used to indicate if A8 is output with the address, required to find the aligned start of blocks:0 = A8 is output1 = A8 is not output.See Secondary mode addressing on SMC databook page 2-45. </description>
                            <bitOffset>7</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>ecc_jump</name>
                            <description> Indicates that the memory supports column change address commands:b00 = no jumping, reads and writes only occur at end of pageb01 = jump using column change commandsb10 = jump using full commandb11 = reserved. </description>
                            <bitOffset>5</bitOffset>
                            <bitWidth>2</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>ecc_read_end</name>
                            <description> Indicates when ECC values are read from memory:0 = the ECC value for a block must be read immediately after the block. Data access must stop on a 512 byte boundary.1 = ECC values for all blocks are read at the end of the page. </description>
                            <bitOffset>4</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>ecc_mode</name>
                            <description> This specifies the mode of the ECC block:b00 = bypassed.b01 = ECC values are calculated and made available on the APB interface, but they are not read from or written to memory.b10 = ECC values and calculated and read/written to memory. For a read, the ECC value is checked and the result of the check is made available on the APB interface.b11 = reserved. </description>
                            <bitOffset>2</bitOffset>
                            <bitWidth>2</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>page_size</name>
                            <description> The number of 512 byte blocks in a page:b00 = No 512 byte blocks. Reserved if an ecc_extra_block is not configured, or if an ecc_extra_block is configured but is not enabled.b01 = One 512 byte block.b10 = Two 512 byte blocks.b11 = Four 512 byte blocks. </description>
                            <bitOffset>0</bitOffset>
                            <bitWidth>2</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                    </fields>
                </register>
                 


