                        <resetValue>0x00000000</resetValue>
                        <resetMask>0xFFFFFFFF</resetMask>
                        <fields>
                            

                            <field>
                                <name>SL_LOCK_INFO</name>
                                <description> bit31: 写0表示解锁对应RESOURCE的LOCK标志 bit[15:8] : 对应RESOURCE的LOCK的MASTER ID bit7: 对应RESOURCE的PROCESS ID 初始化标志（1表示完成PROCESS ID写入，0表示未完成PROCESS ID写入），状态=1只在SPIN_LOCK=2步锁定使用 bit[3:0] : 对应RESOURCE的LOCK的PROCESS ID（软件先取得对应RESOURCE的锁定权后，才能通过[3:0]写入PROCESS ID） 当软件读取SL_LOCK_INFO时，如果该RESOURCE是空闲状态，则会自动进入LOCK状态，并记录该软件运行CPU的MASTER ID信息，RESOURCE进入LOCK状态后，只有之前加锁的运行CPU才能解锁LOCK状态。 </description>
                                <bitOffset>0</bitOffset>
                                <bitWidth>32</bitWidth>
                                <access>read-write</access>
                                <modifiedWriteValues>
