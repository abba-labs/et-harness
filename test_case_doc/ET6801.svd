                        <resetValue>0x00000000</resetValue>
                        <resetMask>0x00000007</resetMask>
                        <fields>
                            

                            <field>
                                <name>FPP_FPT_CNT_CLR</name>
                                <description> 异常预处理0~5 异常计数计数器清零，写1产生脉冲。 </description>
                                <bitOffset>2</bitOffset>
                                <bitWidth>1</bitWidth>
                                <access>read-write</access>
                                <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                            </field>
                            

                            <field>
                                <name>FPP_FPT_LATCH_CLR</name>
                                <description> 异常预处理0~5 锁存的异常信号清除，写1产生脉冲。 </description>
                                <bitOffset>1</bitOffset>
                                <bitWidth>1</bitWidth>
                                <access>read-write</access>
                                <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                            </field>
                            

