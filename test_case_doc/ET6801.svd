                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>int_enable0</name>
                            <description> 0 = No effect 1 = Enables the smc_int0 interrupt. SMC sets the int_en0 bit to 1 in the memc_status Register, see Memory Controller Status Register on SMC databook page 3-8. </description>
                            <bitOffset>0</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                    </fields>
                </register>
                 


                <register>
                    <name>mem_cfg_clr</name>
                    <description>Describe the details of the register: mem_cfg_clr</description>
                    <addressOffset>0x000C</addressOffset>
                    <size>32</size>
                    <access>
                        read-write 
                    </access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0xFE000000</resetMask>
                    <fields>
                        

                        <field>
                            <name>ecc_int_disable1</name>
                            <description> 0 = No effect 1 = Disables the ecc_int1 interrupt. SMC sets the ecc_int_en1 bit to 0 in the memc_status Register, see Memory Controller Status Register on SMC databook page 3-8 </description>
                            <bitOffset>6</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>ecc_int_disable0</name>
                            <description> 0 = No effect 1 = Disables the ecc_int0 interrupt. SMC sets the ecc_int_en0 bit to 0 in the memc_status Register, see Memory Controller Status Register on SMC databook page 3-8 </description>
                            <bitOffset>5</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>int_clear1</name>
                            <description> 0 = No effect 1 = Clear SMC Interrupt 1, as an alternative to an AXI read. </description>
                            <bitOffset>4</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>int_clear0</name>
                            <description> 0 = No effect 1 = Clear SMC Interrupt 0, as an alternative to an AXI read. </description>
                            <bitOffset>3</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>low_power_exit</name>
                            <description> 0 = No effect 1 = Request the SMC to exit Low-power state. </description>
                            <bitOffset>2</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>int_disable1</name>
                            <description> 0 = No effect 1 = Disables the smc_int1 interrupt. SMC sets the int_en1 bit to 0 in the memc_status Register, see Memory Controller Status Register on SMC databook page 3-8 </description>
                            <bitOffset>1</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>int_disable0</name>
                            <description> 0 = No effect 1 = Disables the smc_int0 interrupt. SMC sets the int_en0 bit to 0 in the memc_status Register, see Memory Controller Status Register on SMC databook page 3-8 </description>
                            <bitOffset>0</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                    </fields>
                </register>
                 


                <register>
                    <name>direct_cmd</name>
                    <description>Describe the details of the register: direct_cmd</description>
                    <addressOffset>0x0010</addressOffset>
                    <size>32</size>
                    <access>
                        read-write 
                    </access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0xFFFFFFC0</resetMask>
                    <fields>
                        

                        <field>
                            <name>chip_nmbr</name>
                            <description> Selects chip configuration register bank to update, and enables chip mode register access depending on cmd_type. The encoding is: b000-b011 = Chip selects 1-4 on memory interface 0 b100-b111 = Chip selects 1-4 on memory interface 1. </description>
                            <bitOffset>23</bitOffset>
                            <bitWidth>3</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>cmd_type</name>
                            <description> Selects the command type: b00 = UpdateRegs and AXI b01 = ModeReg b10 = UpdateRegs b11 = ModeReg and UpdateRegs. </description>
                            <bitOffset>21</bitOffset>
                            <bitWidth>2</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>set_cre</name>
                            <description> Maps to the configuration register enable signal, cre, when a ModeReg command is issued. The encoding is: 0 = cre is LOW 1 = cre is HIGH when ModeReg write occurs. </description>
                            <bitOffset>20</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>addr_19_to_0</name>
                            <description> When cmd_type = UpdateRegs and AXI then: • bits [15:0] are used to match wdata[15:0] • bits [19:16] are reserved. Write as zero. When cmd_type = ModeReg or ModeReg and UpdateRegs, these bits map to the external memory address bits [19:0]. When cmd_type = UpdateRegs, these bits are reserved. Write as zero. </description>
                            <bitOffset>0</bitOffset>
                            <bitWidth>20</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                    </fields>
                </register>
                 


                <register>
                    <name>set_cycles</name>
                    <description>Describe the details of the register: set_cycles</description>
                    <addressOffset>0x0014</addressOffset>
                    <size>32</size>
                    <access>
                        read-write 
                    </access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0xFFFFFF00</resetMask>
                    <fields>
                        

                        <field>
                            <name>set_t6</name>
                            <description> Contains the value to be written to either the: • we_time bit of the SRAM Cycles Register on SMC databook page 3-20a • t_rr field of the NAND Cycles Register on SMC databook page 3-21. </description>
                            <bitOffset>20</bitOffset>
                            <bitWidth>4</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>set_t5</name>
                            <description> Contains the value to be written to either the:• t_tr field of the SRAM Cycles Register on SMC databook page 3-20• t_ar field of the NAND Cycles Register on SMC databook page 3-21. </description>
                            <bitOffset>17</bitOffset>
                            <bitWidth>3</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>set_t4</name>
                            <description> Contains the value to be written to either the: • t_pc field of the SRAM Cycles Register on SMC databook page 3-20 • t_clr field of the NAND Cycles Register on SMC databook page 3-21. </description>
                            <bitOffset>14</bitOffset>
                            <bitWidth>3</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>set_t3</name>
                            <description> Contains the value to be written to the t_wp field in either the: • SRAM Cycles Register on SMC databook page 3-20b • NAND Cycles Register on SMC databook page 3-21. </description>
                            <bitOffset>11</bitOffset>
                            <bitWidth>3</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>set_t2</name>
                            <description> Contains the value to be written to either the: • t_ceoe field of the SRAM Cycles Register on SMC databook page 3-20c • t_rea field of the NAND Cycles Register on SMC databook page 3-21. </description>
                            <bitOffset>8</bitOffset>
                            <bitWidth>3</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>set_t1</name>
                            <description> Contains the value to be written to the t_wc field in either the: • SRAM Cycles Register on SMC databook page 3-20 • NAND Cycles Register on SMC databook page 3-21. </description>
                            <bitOffset>4</bitOffset>
                            <bitWidth>4</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>set_t0</name>
                            <description> Contains the value to be written to the t_rc field in either the: • SRAM Cycles Register on SMC databook page 3-20 • NAND Cycles Register on SMC databook page 3-21. </description>
                            <bitOffset>0</bitOffset>
                            <bitWidth>4</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                    </fields>
                </register>
                 


                <register>
                    <name>set_opmode</name>
                    <description>Describe the details of the register: set_opmode</description>
                    <addressOffset>0x0018</addressOffset>
                    <size>32</size>
                    <access>
                        read-write 
                    </access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0xFFFF0000</resetMask>
                    <fields>
                        

                        <field>
                            <name>set_burst_align</name>
                            <description> Contains the value to be written to the specific SRAM chip opmode Register burst_align field. When you configure the SMC to perform synchronous transfersa, these bits control if memory bursts are split on memory burst boundaries: b000 = bursts can cross any address boundary b001 = burst split on memory burst boundary, that is, 32 beats for continuous b010 = burst split on 64 beat boundary b011 = burst split on 128 beat boundary b100 = burst split on 256 beat boundary b101-b111 = reserved. For a NAND memory interface these bits are reserved, and written as zero. </description>
                            <bitOffset>13</bitOffset>
                            <bitWidth>3</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>set_bls_time</name>
                            <description> Contains the value to be written to the specific SRAM chip opmode Register byte lane strobe (bls) bit. This bit affects the assertion of the byte lane strobe outputs. 0 = bls timing equals chip select timing. This is the default setting. 1 = bls timing equals we_n timing. This setting is used for eight memories that have no bls_n inputs. In this case, the bls_n output of the SMC is connected to the we_n memory input. For a NAND memory interface this bit is reserved, and written as zero. </description>
                            <bitOffset>12</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>set_adv</name>
                            <description> Contains the value to be written to the specific SRAM chip opmode Register address valid (adv) bit. The memory uses the address advance signal adv_n when set. For a NAND memory interface this bit is reserved, and written as zero. </description>
                            <bitOffset>11</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>set_baa</name>
                            <description> Contains the value to be written to the specific SRAM chip opmode Register burst address advance (baa) bit. The memory uses the baa_n signal when set. For a NAND memory interface this bit is reserved, and written as zero. </description>
                            <bitOffset>10</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>set_wr_bl</name>
                            <description> Contains the value to be written to the specific SRAM chip opmode Register wr_bl field. Encodes the memory burst length: b000 = 1 beat b001 = 4 beats b010 = 8 beats b011 = 16 beats b100 = 32 beats b101 = continuous b110-b111 = reserved. For a NAND memory interface these bits are reserved, and written as zero. </description>
                            <bitOffset>7</bitOffset>
                            <bitWidth>3</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>set_wr_sync</name>
                            <description> Contains the value to be written to the specific SRAM chip opmode Register wr_sync bit. The memory writes are synchronous when set. For a NAND memory interface this bit is reserved, and written as zero. </description>
                            <bitOffset>6</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>set_rd_bl</name>
                            <description> Contains the value to be written to the specific SRAM chip opmode Register rd_bl field. Encodes the memory burst length: b000 = 1 beat b001 = 4 beats b010 = 8 beats b011 = 16 beats b100 = 32 beats b101 = continuous b110-b111 = reserved. For a NAND memory interface these bits are reserved, and written as zero. </description>
                            <bitOffset>3</bitOffset>
                            <bitWidth>3</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>set_rd_sync</name>
                            <description> Contains the value to be written to the specific SRAM chip opmode Register rd_sync bit. Memory in sync mode when set.For a NAND memory interface this bit is reserved, and written as zero. </description>
                            <bitOffset>2</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>set_mw</name>
                            <description> Contains the value to be written to the specific chip opmode Register memory width (mw) field. Encodes the memory data bus width: b00 = 8 bitsb b01 = 16 bitsb b10 = 32 bits b11 = reserved. You can program this to the configured width, or half that width. See Memory Interface Configuration Register on SMC databook page 3-9. </description>
                            <bitOffset>0</bitOffset>
                            <bitWidth>2</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                    </fields>
                </register>
                 


                <register>
                    <name>refresh_0</name>
                    <description>Describe the details of the register: refresh_0</description>
                    <addressOffset>0x0020</addressOffset>
                    <size>32</size>
                    <access>
                        read-write 
                    </access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0xF0000000</resetMask>
                    <fields>
                        

                        <field>
                            <name>ref_period0</name>
                            <description> Sets the number of consecutive memory burstsa that the SMC permits, on memory interface 0, before it deasserts the chip select. The options are:b0000 = disables the insertion of idle cycles between consecutive burstsb0001 = an idle cycle occurs after each burstb0010 = an idle cycle occurs after 2 consecutive burstsb0011 = an idle cycle occurs after 3 consecutive burstsb0100 = an idle cycle occurs after 4 consecutive bursts...b1111 = an idle cycle occurs after 15 consecutive bursts. </description>
                            <bitOffset>0</bitOffset>
                            <bitWidth>4</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                    </fields>
                </register>
                 


                <register>
                    <name>refresh_1</name>
                    <description>Describe the details of the register: refresh_1</description>
                    <addressOffset>0x0024</addressOffset>
                    <size>32</size>
                    <access>
                        read-write 
                    </access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0xF0000000</resetMask>
                    <fields>
                        

                        <field>
                            <name>ref_period1</name>
                            <description> Sets the number of consecutive memory burstsa that the SMC permits, on memory interface 1, before it deasserts the chip select. The options are:b0000 = disables the insertion of idle cycles between consecutive burstsb0001 = an idle cycle occurs after each burstb0010 = an idle cycle occurs after 2 consecutive burstsb0011 = an idle cycle occurs after 3 consecutive burstsb0100 = an idle cycle occurs after 4 consecutive bursts...b1111 = an idle cycle occurs after 15 consecutive bursts. </description>
                            <bitOffset>0</bitOffset>
                            <bitWidth>4</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                    </fields>
                </register>
                 


                <register>
                    <name>intf0_chip0_sram_cycles</name>
                    <description>Describe the details of the register: intf0_chip0_sram_cycles</description>
                    <addressOffset>0x0100</addressOffset>
                    <size>32</size>
                    <access>
                        read-only
                    </access>
                    <resetValue>0x0002B3CC</resetValue>
                    <resetMask>0xFFFFF800</resetMask>
                    <fields>
                        

                        <field>
                            <name>we_time</name>
                            <description> For asynchronous multiplexed transfers this bit returns when the SMC asserts we_n:0 = SMC asserts we_n two mclk cycles after asserting cs_n. See Figure 2-17 on SMC databook page 2-29.1 = SMC asserts we_n and cs_n together. </description>
                            <bitOffset>20</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-only</access>
                        </field>
                        

                        <field>
                            <name>t_tr</name>
                            <description> Returns the turnaround time. Minimum permitted value = 1. </description>
                            <bitOffset>17</bitOffset>
                            <bitWidth>3</bitWidth>
                            <access>read-only</access>
                        </field>
                        

                        <field>
                            <name>t_pc</name>
                            <description> Returns the page cycle time. Minimum permitted value = 1. </description>
                            <bitOffset>14</bitOffset>
                            <bitWidth>3</bitWidth>
                            <access>read-only</access>
                        </field>
                        

                        <field>
                            <name>t_wp</name>
                            <description> Returns the we_n assertion delay. Minimum permitted value = 1. </description>
                            <bitOffset>11</bitOffset>
                            <bitWidth>3</bitWidth>
                            <access>read-only</access>
                        </field>
                        

                        <field>
                            <name>t_ceoe</name>
                            <description> Returns the oe_n assertion delay. Minimum permitted value = 1. </description>
                            <bitOffset>8</bitOffset>
                            <bitWidth>3</bitWidth>
                            <access>read-only</access>
                        </field>
                        

                        <field>
                            <name>t_wc</name>
                            <description> Returns the write cycle time. Minimum permitted value = 2. </description>
                            <bitOffset>4</bitOffset>
                            <bitWidth>4</bitWidth>
                            <access>read-only</access>
                        </field>
                        

                        <field>
                            <name>t_rc</name>
                            <description> Returns the read cycle time. Minimum permitted value = 2. </description>
                            <bitOffset>0</bitOffset>
                            <bitWidth>4</bitWidth>
                            <access>read-only</access>
                        </field>
                        

                    </fields>
                </register>
                 


                <register>
                    <name>opmode_intf0_chip0</name>
                    <description>Describe the details of the register: opmode_intf0_chip0</description>
                    <addressOffset>0x0104</addressOffset>
                    <size>32</size>
                    <access>
                        read-only
                    </access>
                    <resetValue>0xF0FF0801</resetValue>
                    <resetMask>0xFFFFFFFF</resetMask>
                    <fields>
                        

                        <field>
                            <name>addr_match_intf0</name>
                            <description> Returns the value of the addr_match_intf0_chip0[7:0] tie-off. This is the comparison value for address bits [31:24] to determine the chip that is selected. </description>
                            <bitOffset>24</bitOffset>
                            <bitWidth>8</bitWidth>
                            <access>read-only</access>
                        </field>
                        

                        <field>
                            <name>addr_mask_intf0</name>
                            <description> Returns the value of the addr_mask_intf0_chip0[7:0] tie-off. This is the mask for address bits[31:24]. A logic 1 indicates the bit is used for comparison. </description>
                            <bitOffset>16</bitOffset>
                            <bitWidth>8</bitWidth>
                            <access>read-only</access>
                        </field>
                        

                        <field>
                            <name>burst_align_intf0</name>
                            <description> When you program the SMC to perform synchronous transfersa, these bits return the memory burst operating mode:b000 = bursts can cross any address boundary. This is the default setting.b001 = burst split on memory burst boundary, that is, 32 beats for continuous.b010 = burst split on 64 beat boundary.b011 = burst split on 128 beat boundary.b100 = burst split on 256 beat boundary.b101-b111 = reserved.The reset value is b000.For a NAND memory interface these bits are reserved. </description>
                            <bitOffset>13</bitOffset>
                            <bitWidth>3</bitWidth>
                            <access>read-only</access>
                        </field>
                        

                        <field>
                            <name>bls_time_intf0</name>
                            <description> Returns the byte lane strobe operating mode for an SRAM memory interface:0 = bls timing equals chip select timing. This is the default setting.1 = bls timing equals we_n timing.For a NAND memory interface this bit is reserved. </description>
                            <bitOffset>12</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-only</access>
                        </field>
                        

                        <field>
                            <name>adv_intf0</name>
                            <description> Returns the address advance signal operating mode for an SRAM memory interface:0 = SMC ties adv_n HIGH. This is the default setting.1 = SMC sets adv_n LOW at the start of a transfer.For a NAND memory interface this bit is reserved. </description>
                            <bitOffset>11</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-only</access>
                        </field>
                        

                        <field>
                            <name>baa_intf0</name>
                            <description> Returns the burst address advance signal operating mode for an SRAM memory interface:0 = SMC ties baa_n HIGH. This is the default setting.1 = SMC sets baa_n LOW.For a NAND memory interface this bit is reserved. </description>
                            <bitOffset>10</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-only</access>
                        </field>
                        

                        <field>
                            <name>wr_bl_intf0</name>
                            <description> Returns the memory burst length for writes on an SRAM memory interface:b000 = 1 beat. This is the default setting.b001 = 4 beatsb010 = 8 beatsb011 = 16 beatsb100 = 32 beatsb101 = continuousb110-b111 = reserved.For a NAND memory interface these bits are reserved. </description>
                            <bitOffset>7</bitOffset>
                            <bitWidth>3</bitWidth>
                            <access>read-only</access>
                        </field>
                        

                        <field>
                            <name>wr_sync_intf0</name>
                            <description> Returns the write operating mode for an SRAM memory interface:0 = SMC performs asynchronous writes. This is the default setting.1 = SMC performs synchronous writes.For a NAND memory interface this bit is reserved. </description>
                            <bitOffset>6</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-only</access>
                        </field>
                        

                        <field>
                            <name>rd_bl_intf0</name>
                            <description> Returns the memory burst length for reads on an SRAM memory interface:b000 = 1 beat. This is the default setting.b001 = 4 beatsb010 = 8 beatsb011 = 16 beatsb100 = 32 beatsb101 = continuousb110-b111 = reserved.For a NAND memory interface these bits are reserved. </description>
                            <bitOffset>3</bitOffset>
                            <bitWidth>3</bitWidth>
                            <access>read-only</access>
                        </field>
                        

                        <field>
                            <name>rd_sync_intf0</name>
                            <description> Returns the read operating mode for an SRAM memory interface:0 = SMC performs asynchronous reads. This is the default setting.1 = SMC performs synchronous reads.For a NAND memory interface this bit is reserved. </description>
                            <bitOffset>2</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-only</access>
                        </field>
                        

                        <field>
                            <name>mw_intf0</name>
                            <description> Returns the SMC memory data bus width:b00 = 8 bitsb01 = 16 bitsb10 = 32 bitsb11 = reserved.You can use the sram_mw__intf0[1:0] or nand_mw__intf0 tie-offs to set the memory width for chip select 0, memory interface _intf0, to enable booting from that chip. The reset value of memory width for all other chip selects is the configured width. </description>
                            <bitOffset>0</bitOffset>
                            <bitWidth>2</bitWidth>
                            <access>read-only</access>
                        </field>
                        

                    </fields>
                </register>
                 


                <register>
                    <name>intf0_chip1_sram_cycles</name>
                    <description>Describe the details of the register: intf0_chip1_sram_cycles</description>
                    <addressOffset>0x0120</addressOffset>
                    <size>32</size>
                    <access>
                        read-only
                    </access>
                    <resetValue>0x0002B3CC</resetValue>
                    <resetMask>0xFFFFF800</resetMask>
                    <fields>
                        

                        <field>
                            <name>we_time</name>
                            <description> For asynchronous multiplexed transfers this bit returns when the SMC asserts we_n:0 = SMC asserts we_n two mclk cycles after asserting cs_n. See Figure 2-17 on SMC databook page 2-29.1 = SMC asserts we_n and cs_n together. </description>
                            <bitOffset>20</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-only</access>
                        </field>
                        

                        <field>
                            <name>t_tr</name>
                            <description> Returns the turnaround time. Minimum permitted value = 1. </description>
                            <bitOffset>17</bitOffset>
                            <bitWidth>3</bitWidth>
                            <access>read-only</access>
                        </field>
                        

                        <field>
                            <name>t_pc</name>
                            <description> Returns the page cycle time. Minimum permitted value = 1. </description>
                            <bitOffset>14</bitOffset>
                            <bitWidth>3</bitWidth>
                            <access>read-only</access>
                        </field>
                        

                        <field>
                            <name>t_wp</name>
                            <description> Returns the we_n assertion delay. Minimum permitted value = 1. </description>
                            <bitOffset>11</bitOffset>
                            <bitWidth>3</bitWidth>
                            <access>read-only</access>
                        </field>
                        

                        <field>
                            <name>t_ceoe</name>
                            <description> Returns the oe_n assertion delay. Minimum permitted value = 1. </description>
                            <bitOffset>8</bitOffset>
                            <bitWidth>3</bitWidth>
                            <access>read-only</access>
                        </field>
                        

                        <field>
                            <name>t_wc</name>
                            <description> Returns the write cycle time. Minimum permitted value = 2. </description>
                            <bitOffset>4</bitOffset>
                            <bitWidth>4</bitWidth>
                            <access>read-only</access>
                        </field>
                        

                        <field>
                            <name>t_rc</name>
                            <description> Returns the read cycle time. Minimum permitted value = 2. </description>
                            <bitOffset>0</bitOffset>
                            <bitWidth>4</bitWidth>
                            <access>read-only</access>
                        </field>
                        

                    </fields>
                </register>
                 


                <register>
                    <name>opmode_intf0_chip1</name>
                    <description>Describe the details of the register: opmode_intf0_chip1</description>
                    <addressOffset>0x0124</addressOffset>
                    <size>32</size>
                    <access>
                        read-only
                    </access>
                    <resetValue>0xF1FF0801</resetValue>
                    <resetMask>0xFFFFFFFF</resetMask>
                    <fields>
                        

                        <field>
                            <name>addr_match_intf0</name>
                            <description> Returns the value of the addr_match_intf0_chip1[7:0] tie-off. This is the comparison value for address bits [31:24] to determine the chip that is selected. </description>
                            <bitOffset>24</bitOffset>
                            <bitWidth>8</bitWidth>
                            <access>read-only</access>
                        </field>
                        

                        <field>
                            <name>addr_mask_intf0</name>
                            <description> Returns the value of the addr_mask_intf0_chip1[7:0] tie-off. This is the mask for address bits[31:24]. A logic 1 indicates the bit is used for comparison. </description>
                            <bitOffset>16</bitOffset>
                            <bitWidth>8</bitWidth>
                            <access>read-only</access>
                        </field>
                        

                        <field>
                            <name>burst_align_intf0</name>
                            <description> When you program the SMC to perform synchronous transfersa, these bits return the memory burst operating mode:b000 = bursts can cross any address boundary. This is the default setting.b001 = burst split on memory burst boundary, that is, 32 beats for continuous.b010 = burst split on 64 beat boundary.b011 = burst split on 128 beat boundary.b100 = burst split on 256 beat boundary.b101-b111 = reserved.The reset value is b000.For a NAND memory interface these bits are reserved. </description>
                            <bitOffset>13</bitOffset>
                            <bitWidth>3</bitWidth>
                            <access>read-only</access>
                        </field>
                        

                        <field>
                            <name>bls_time_intf0</name>
                            <description> Returns the byte lane strobe operating mode for an SRAM memory interface:0 = bls timing equals chip select timing. This is the default setting.1 = bls timing equals we_n timing.For a NAND memory interface this bit is reserved. </description>
                            <bitOffset>12</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-only</access>
                        </field>
                        

                        <field>
                            <name>adv_intf0</name>
                            <description> Returns the address advance signal operating mode for an SRAM memory interface:0 = SMC ties adv_n HIGH. This is the default setting.1 = SMC sets adv_n LOW at the start of a transfer.For a NAND memory interface this bit is reserved. </description>
                            <bitOffset>11</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-only</access>
                        </field>
                        

                        <field>
                            <name>baa_intf0</name>
                            <description> Returns the burst address advance signal operating mode for an SRAM memory interface:0 = SMC ties baa_n HIGH. This is the default setting.1 = SMC sets baa_n LOW.For a NAND memory interface this bit is reserved. </description>
                            <bitOffset>10</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-only</access>
                        </field>
                        

                        <field>
                            <name>wr_bl_intf0</name>
                            <description> Returns the memory burst length for writes on an SRAM memory interface:b000 = 1 beat. This is the default setting.b001 = 4 beatsb010 = 8 beatsb011 = 16 beatsb100 = 32 beatsb101 = continuousb110-b111 = reserved.For a NAND memory interface these bits are reserved. </description>
                            <bitOffset>7</bitOffset>
                            <bitWidth>3</bitWidth>
                            <access>read-only</access>
                        </field>
                        

                        <field>
                            <name>wr_sync_intf0</name>
                            <description> Returns the write operating mode for an SRAM memory interface:0 = SMC performs asynchronous writes. This is the default setting.1 = SMC performs synchronous writes.For a NAND memory interface this bit is reserved. </description>
                            <bitOffset>6</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-only</access>
                        </field>
                        

                        <field>
                            <name>rd_bl_intf0</name>
                            <description> Returns the memory burst length for reads on an SRAM memory interface:b000 = 1 beat. This is the default setting.b001 = 4 beatsb010 = 8 beatsb011 = 16 beatsb100 = 32 beatsb101 = continuousb110-b111 = reserved.For a NAND memory interface these bits are reserved. </description>
                            <bitOffset>3</bitOffset>
                            <bitWidth>3</bitWidth>
                            <access>read-only</access>
                        </field>
                        

                        <field>
                            <name>rd_sync_intf0</name>
                            <description> Returns the read operating mode for an SRAM memory interface:0 = SMC performs asynchronous reads. This is the default setting.1 = SMC performs synchronous reads.For a NAND memory interface this bit is reserved. </description>
                            <bitOffset>2</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-only</access>
                        </field>
                        

                        <field>
                            <name>mw_intf0</name>
                            <description> Returns the SMC memory data bus width:b00 = 8 bitsb01 = 16 bitsb10 = 32 bitsb11 = reserved.You can use the sram_mw__intf0[1:0] or nand_mw__intf0 tie-offs to set the memory width for chip select 0, memory interface _intf0, to enable booting from that chip. The reset value of memory width for all other chip selects is the configured width. </description>
                            <bitOffset>0</bitOffset>
                            <bitWidth>2</bitWidth>
                            <access>read-only</access>
                        </field>
                        

                    </fields>
                </register>
                 


