                            <name>TB_PRD_LDSYNC_MSEL</name>
                            <description> timer_base周期同步加载同步信号选择，从同步加载事件集合1中选择，采用Mask_OR的方式。 </description>
                            <bitOffset>0</bitOffset>
                            <bitWidth>14</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                    </fields>
                </register>
                


                <register>
                    <name>TB_PH_LDSYNC</name>
                    <description>TB_PH_LDSYNC</description>
                    <addressOffset>0x0024</addressOffset>
                    <size>32</size>
                    <access>
                        read-write
                    </access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0x00013FFF</resetMask>
                    <fields>
                        

                        <field>
                            <name>TB_PH_LDSYNC_EN</name>
                            <description> timer_base相位同步加载使能配置。 0：不同步加载，配置后cfg_tb_0phase立即生效； 1：同步加载，配置后等相位同步加载信号（来自于对同步加载事件集合1的选择）到来后cfg_tb_0phase才生效。 注意： 这里的同步信号到来后生效是指同步信号到来后此配置值可用，并不是已加载到时基计数器中，真正加载到时基计数器中改变其相位，需等时基同步信号0生效； cfg_tb_1phase不受此配置影响，cfg_tb_1phase只支持立即生效模式； </description>
                            <bitOffset>16</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>TB_PH_LDSYNC_MSEL</name>
                            <description> timer_base相位同步加载同步信号选择，从同步加载事件集合1中选择，采用Mask_OR的方式。 </description>
                            <bitOffset>0</bitOffset>
                            <bitWidth>14</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                    </fields>
                </register>
                


                <register>
