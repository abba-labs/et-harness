                            <description>Read this register to clear the combined interrupt, all 
                  individual interrupts, and the IC_TX_ABRT_SOURCE 
                  register. This bit does not clear hardware clearable interrupts 
                  but software clearable interrupts.</description>
                            
                        
                            <bitOffset>0</bitOffset>
                            
                        
                            <bitWidth>1</bitWidth>
                            
                        
                            <access>read-only</access>
                            
                    
                        </field>
                        
                
                    </fields>
                    
            
                </register>
                
            
