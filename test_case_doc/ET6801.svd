                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>CH_EN</name>
                            <description> Channel Enable. The ChEnReg.CH_EN bit is automatically cleared by hardware to disable the channel after the last AMBA transfer of the DMA transfer to the destination has completed. Software can therefore poll this bit to determine when this channel is free for a new DMA transfer.Values: 0x0 (DISABLED): Disable the channel0x1 (ENABLED): Enable the channel </description>
                            <bitOffset>0</bitOffset>
                            <bitWidth>8</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
