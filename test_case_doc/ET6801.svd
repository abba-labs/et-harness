                <register>
                    
            
                    <name>FAR</name>
                    
            
                    <addressOffset>0x70</addressOffset>
                    
            
                    <description>FIFO Access Register.</description>
                    
            
                    <size>32</size>
                    
            
                    <access>read-write</access>
                    
            
                    <resetValue>0x00000000</resetValue>
                    
            
                    <resetMask>0xFFFFFFFF</resetMask>
                    
            
                    <fields>
                        
            
                        <field>
                            
                
                            <name>RSVD_FAR_31TO1</name>
                            
                
                            <description>FAR 31to1 Reserved bits read as 0.</description>
                            
                
                            <bitOffset>1</bitOffset>
                            
                
                            <bitWidth>31</bitWidth>
                            
                
                            <access>read</access>
                            
                
                            <modifiedWriteValues/>
                            
            
                        </field>
                        
            
                        <field>
                            
                
                            <name>FAR</name>
                            
                
                            <description>Writes will have no effect when FIFO_ACCESS == No, always readable. This register is use to enable a FIFO access mode for testing, so that the receive FIFO can be written by the master and the transmit FIFO can be read by the master when FIFO's are implemented and enabled. When FIFOs are not implemented or not enabled it allows the RBR to be written by the master and the THR to be read by the master.</description>
                            
                
                            <bitOffset>0</bitOffset>
                            
                
                            <bitWidth>1</bitWidth>
                            
                
                            <access>read-write</access>
                            
                
                            <modifiedWriteValues/>
                            
            
                        </field>
                        
            
                    </fields>
                    
        
                </register>
                
        
                <register>
                    
            
                    <name>TFR</name>
                    
            
                    <addressOffset>0x74</addressOffset>
                    
            
                    <description>TFR</description>
                    
            
                    <size>32</size>
                    
            
                    <access>read-write</access>
                    
            
                    <resetValue>0x00000000</resetValue>
                    
            
                    <resetMask>0xFFFFFFFF</resetMask>
                    
            
                    <fields>
                        
            
                        <field>
                            
                
                            <name>RSVD_TFR_31TO8</name>
                            
                
                            <description>TFR 31to8 Reserved bits read as 0.</description>
                            
                
                            <bitOffset>8</bitOffset>
                            
                
                            <bitWidth>24</bitWidth>
                            
                
                            <access>read</access>
                            
                
                            <modifiedWriteValues/>
                            
            
                        </field>
                        
            
                        <field>
                            
                
                            <name>TFR</name>
                            
                
                            <description>These bits are only valid when FIFO access mode is enabled(FAR[0] is set to one).
        When FIFO's are implemented and enabled, reading this register gives the data at the top of the transmit FIFO. Each consecutive read pops the transmit FIFO and gives the next data value that is currently at the top of the FIFO. When FIFO's are not implemented or not enabled, reading this register gives the data in the THR.</description>
                            
                
                            <bitOffset>0</bitOffset>
                            
                
                            <bitWidth>8</bitWidth>
                            
                
                            <access>read</access>
                            
                
                            <modifiedWriteValues/>
                            
            
                        </field>
                        
            
                    </fields>
                    
        
                </register>
                
        
                <register>
                    
            
                    <name>RFW</name>
                    
            
                    <addressOffset>0x78</addressOffset>
                    
            
                    <description>Receive FIFO Write</description>
                    
            
                    <size>32</size>
                    
            
                    <access>read-write</access>
                    
            
                    <resetValue>0x00000000</resetValue>
                    
            
                    <resetMask>0xFFFFFFFF</resetMask>
                    
            
                    <fields>
                        
            
                        <field>
                            
                
                            <name>RSVD_RFW_31TO10</name>
                            
                
                            <description>RFW 31to10 Reserved bits read as 0.</description>
                            
                
                            <bitOffset>10</bitOffset>
                            
                
                            <bitWidth>22</bitWidth>
                            
                
                            <access>read</access>
                            
                
                            <modifiedWriteValues/>
                            
            
                        </field>
                        
            
                        <field>
                            
                
                            <name>RFFE</name>
                            
                
                            <description>These bits are only valid when FIFO access mode is enabled(FAR[0] is set to one). When FIFO's are implemented and enabled, this bit is used to write framing error detection information to the receive FIFO. When FIFO's are not implemented or not enabled, this bit is used to write framing error detection information to the RBR.</description>
                            
                
                            <bitOffset>9</bitOffset>
                            
                
                            <bitWidth>1</bitWidth>
                            
                
                            <access>write</access>
                            
                
                            <modifiedWriteValues/>
                            
            
                        </field>
                        
            
                        <field>
                            
                
                            <name>RFPE</name>
                            
                
                            <description>These bits are only valid when FIFO access mode is enabled(FAR[0] is set to one). When FIFO's are implemented and enabled, this bit is used to write parity error detection information to the receive FIFO. When FIFO's are not implemented or not enabled, this bit is used to write parity error detection information to the RBR.</description>
                            
                
                            <bitOffset>8</bitOffset>
                            
                
                            <bitWidth>1</bitWidth>
                            
                
                            <access>write</access>
                            
                
                            <modifiedWriteValues/>
                            
            
                        </field>
                        
            
                        <field>
                            
                
                            <name>RFWD</name>
                            
                
                            <description>These bits are only valid when FIFO access mode is enabled (FAR[0] is set to one). When FIFO's are implemented and enabled, the data that is written to the RFWD is pushed into the receive FIFO. Each consecutive write pushes the new data to the next write location in the receive FIFO. When FIFO's are not implemented or not enabled, the data that is written to the RFWD is pushed into the RBR.</description>
                            
                
                            <bitOffset>0</bitOffset>
                            
                
                            <bitWidth>8</bitWidth>
                            
                
                            <access>write</access>
                            
                
                            <modifiedWriteValues/>
                            
            
                        </field>
                        
            
                    </fields>
                    
        
                </register>
                
        
                <register>
                    
            
                    <name>USR</name>
                    
            
                    <addressOffset>0x7c</addressOffset>
                    
            
                    <description>UART Status register</description>
                    
            
                    <size>32</size>
                    
            
                    <access>read-write</access>
                    
            
