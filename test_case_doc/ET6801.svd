                    <resetMask>0xFFFFFFFF</resetMask>
                    
            
                    <fields>
                        
            
                        <field>
                            
                
                            <name>RSVD_LSR_31TO9</name>
                            
                
                            <description>LSR 31to9 Reserved bits read as zero.</description>
                            
                
                            <bitOffset>9</bitOffset>
                            
                
                            <bitWidth>23</bitWidth>
                            
                
                            <access>read</access>
                            
                
                            <modifiedWriteValues/>
                            
            
                        </field>
                        
            
                        <field>
                            
                
                            <name>ADDR_RCVD</name>
                            
                
                            <description>This bit is used to indicate the 9th bit of the receive data is set to 1. This bit can also be used to indicate whether the incoming character is address or data.</description>
                            
                
                            <bitOffset>8</bitOffset>
                            
                
                            <bitWidth>1</bitWidth>
                            
                
                            <access>read</access>
                            
                
                            <modifiedWriteValues/>
                            
            
                        </field>
                        
            
                        <field>
                            
                
                            <name>RFE</name>
                            
                
                            <description>This is used to indicate if there is at least one parity error, framing error, or break indication in the FIFO.</description>
                            
                
                            <bitOffset>7</bitOffset>
                            
                
                            <bitWidth>1</bitWidth>
                            
                
                            <access>read</access>
                            
                
                            <modifiedWriteValues/>
                            
            
                        </field>
                        
            
                        <field>
                            
                
                            <name>TEMT</name>
                            
                
                            <description>This bit is set whenever the Transmitter Shift Register and the FIFO are both empty. If in the non-FIFO mode or FIFO's are disabled, this bit is set whenever the Transmitter Holding Register and the Transmitter Shift Register are both empty.</description>
                            
                
                            <bitOffset>6</bitOffset>
                            
                
                            <bitWidth>1</bitWidth>
                            
                
                            <access>read</access>
                            
                
                            <modifiedWriteValues/>
                            
            
                        </field>
                        
            
                        <field>
                            
                
                            <name>THRE</name>
                            
                
                            <description>This bit indicates that the THR or TX FIFO is empty.</description>
                            
                
                            <bitOffset>5</bitOffset>
                            
                
                            <bitWidth>1</bitWidth>
                            
                
                            <access>read</access>
                            
                
                            <modifiedWriteValues/>
                            
            
                        </field>
                        
            
                        <field>
                            
                
                            <name>BI</name>
                            
                
                            <description>This is used to indicate the detection of a break sequence on the serial input data.</description>
                            
                
                            <bitOffset>4</bitOffset>
                            
                
                            <bitWidth>1</bitWidth>
                            
                
                            <access>read</access>
                            
                
                            <modifiedWriteValues/>
                            
            
                        </field>
                        
            
                        <field>
                            
                
                            <name>FE</name>
                            
                
                            <description>This is used to indicate the occurrence of a framing error in the receiver. A framing error occurs when the receiver does not detect a valid STOP bit in the received data.</description>
                            
                
                            <bitOffset>3</bitOffset>
                            
                
                            <bitWidth>1</bitWidth>
                            
                
                            <access>read</access>
                            
                
                            <modifiedWriteValues/>
                            
            
                        </field>
                        
            
                        <field>
                            
                
                            <name>PE</name>
                            
                
                            <description>This is used to indicate the occurrence of a parity error in the receiver if the Parity Enable (PEN) bit (LCR[3]) is set. In the FIFO mode, since the parity error is associated with a character received, it is revealed when the character with the parity error arrives at the top of the FIFO.</description>
                            
                
                            <bitOffset>2</bitOffset>
                            
                
                            <bitWidth>1</bitWidth>
                            
                
                            <access>read</access>
                            
                
                            <modifiedWriteValues/>
                            
            
                        </field>
                        
            
                        <field>
                            
                
                            <name>OE</name>
                            
                
                            <description>This is used to indicate the occurrence of an overrun error. This occurs if a new data character was received before the previous data was read.</description>
                            
                
                            <bitOffset>1</bitOffset>
                            
                
                            <bitWidth>1</bitWidth>
                            
                
                            <access>read</access>
                            
                
                            <modifiedWriteValues/>
                            
            
                        </field>
                        
            
                        <field>
                            
                
                            <name>DR</name>
                            
                
                            <description>This is used to indicate that the receiver contains at least one character in the RBR or the receiver FIFO. This bit is cleared when the RBR is read in the non-FIFO mode, or when the receiver FIFO is empty, in the FIFO mode.</description>
                            
                
                            <bitOffset>0</bitOffset>
                            
                
                            <bitWidth>1</bitWidth>
                            
                
                            <access>read</access>
                            
                
                            <modifiedWriteValues/>
                            
            
                        </field>
                        
            
                    </fields>
                    
        
                </register>
                
        
                <register>
                    
            
                    <name>MSR</name>
                    
            
                    <addressOffset>0x18</addressOffset>
                    
            
                    <description>Modem Status Register</description>
                    
            
                    <size>32</size>
                    
            
                    <access>read</access>
                    
            
                    <resetValue>0x00000000</resetValue>
                    
            
                    <resetMask>0xFFFFFFFF</resetMask>
                    
            
                    <fields>
                        
            
                        <field>
                            
                
                            <name>RSVD_MSR_31TO8</name>
                            
                
                            <description>MSR 31to8 Reserved bits read as 0.</description>
                            
                
                            <bitOffset>8</bitOffset>
                            
                
                            <bitWidth>24</bitWidth>
                            
                
                            <access>read</access>
                            
                
                            <modifiedWriteValues/>
                            
            
                        </field>
                        
            
                        <field>
                            
                
                            <name>DCD</name>
                            
                
                            <description>This is used to indicate the current state of the modem control line dcd_n. That is this bit is the complement dcd_n. When the Data Carrier Detect input (dcd_n) is asserted it is an indication that the carrier has been detected by the modem or data set.</description>
                            
                
                            <bitOffset>7</bitOffset>
                            
                
                            <bitWidth>1</bitWidth>
                            
                
                            <access>read</access>
                            
                
                            <modifiedWriteValues/>
                            
            
                        </field>
                        
            
                        <field>
                            
                
                            <name>RI</name>
                            
                
                            <description>This is used to indicate the current state of the modem control line ri_n. That is this bit is the complement ri_n. When the Ring Indicator input (ri_n) is asserted it is an indication that a telephone ringing signal has been received by the modem or data set.</description>
                            
                
                            <bitOffset>6</bitOffset>
                            
                
                            <bitWidth>1</bitWidth>
                            
                
                            <access>read</access>
                            
                
                            <modifiedWriteValues/>
                            
            
                        </field>
                        
            
                        <field>
                            
                
                            <name>DSR</name>
                            
                
                            <description>This is used to indicate the current state of the modem control line dsr_n. That is this bit is the complement dsr_n. When the Data Set Ready input (dsr_n) is asserted it is an indication that the modem or data set is ready to establish communications with the DW_apb_uart.</description>
                            
                
                            <bitOffset>5</bitOffset>
                            
                
                            <bitWidth>1</bitWidth>
                            
                
                            <access>read</access>
                            
                
                            <modifiedWriteValues/>
                            
            
                        </field>
                        
            
                        <field>
                            
                
                            <name>CTS</name>
                            
                
                            <description>This is used to indicate the current state of the modem control line cts_n. </description>
                            
                
                            <bitOffset>4</bitOffset>
                            
                
                            <bitWidth>1</bitWidth>
                            
                
