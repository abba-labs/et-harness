                    <resetValue>0x00000000</resetValue>
                    <resetMask>0x00000001</resetMask>
                    <fields>
                        

                        <field>
                            <name>LP_BYPASS</name>
                            <description> LIN控制器低功耗bypass功能 0：启用低功耗功能 1：bypass低功耗功能 </description>
                            <bitOffset>0</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
