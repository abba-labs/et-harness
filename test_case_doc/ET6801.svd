                    <register>
                        <name>DSRX</name>
                        <description>DSRx</description>
                        <addressOffset>0x50</addressOffset>
                        <size>32</size>
                        <access>
                        read-write 
                    </access>
                        <resetValue>0x00000000</resetValue>
                        <resetMask>0xFFFFFFFF</resetMask>
                        <fields>
                            

                            <field>
                                <name>DSC</name>
                                <description> Destination Scatter Count. Destination contiguous transfer count between successive scatter boundaries. </description>
                                <bitOffset>20</bitOffset>
                                <bitWidth>12</bitWidth>
                                <access>read-write</access>
                                <modifiedWriteValues>
                            modify
