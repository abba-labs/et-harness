                    <register>
                        <name>SSTATARX</name>
                        <description>SSTATARx</description>
                        <addressOffset>0x30</addressOffset>
                        <size>32</size>
                        <access>
                        read-write 
                    </access>
                        <resetValue>0x00000000</resetValue>
                        <resetMask>0xFFFFFFFF</resetMask>
                        <fields>
                            

                            <field>
                                <name>SSTATAR</name>
                                <description> Pointer from where hardware can fetch the source status information, which is registered in the SSTATx register and written out to the SSTATx register location of the LLI before the start of the next block. </description>
                                <bitOffset>0</bitOffset>
                                <bitWidth>32</bitWidth>
                                <access>read-write</access>
