                        <access>
                        read-only
                    </access>
                        <resetValue>0x00000000</resetValue>
                        <resetMask>0xFFFFFFFF</resetMask>
                        <fields>
                            

                            <field>
                                <name>PWM_RLCNT</name>
                                <description> Counter实时值上报，只读 </description>
                                <bitOffset>0</bitOffset>
                                <bitWidth>32</bitWidth>
                                <access>read-only</access>
                            </field>
                            

                        </fields>
                    </register>
                    


                    <register>
                        <name>CTRPHS</name>
                        <description>CTRPHS</description>
                        <addressOffset>0x1c</addressOffset>
                        <size>32</size>
                        <access>
                        read-write
                    </access>
                        <resetValue>0x00000000</resetValue>
                        <resetMask>0xFFFFFFFF</resetMask>
                        <fields>
                            

                            <field>
                                <name>SYNC_CTRPHS</name>
                                <description> 相位控制寄存器,同步信号到来时，加载此寄存器到计数器中 </description>
                                <bitOffset>0</bitOffset>
                                <bitWidth>32</bitWidth>
                                <access>read-write</access>
                                <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                            </field>
                            

                        </fields>
                    </register>
                    


                    <register>
                        <name>SYNC_CTRL</name>
                        <description>SYNC_CTRL</description>
                        <addressOffset>0x20</addressOffset>
                        <size>32</size>
                        <access>
                        read-write
                    </access>
                        <resetValue>0x00000000</resetValue>
                        <resetMask>0x0000333F</resetMask>
                        <fields>
                            

                            <field>
                                <name>SYNCO_SEL</name>
                                <description> 内部同步源etim_sync_out信号源选择： 'd0:选择软件配置同步 'd1:选择ETIM计数到周期同步 'd2:关闭etim_sync_out输出信号（输出为0） 'd3: 关闭etim_sync_out输出信号（输出为0） </description>
                                <bitOffset>12</bitOffset>
                                <bitWidth>2</bitWidth>
                                <access>read-write</access>
                                <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                            </field>
                            

                            <field>
                                <name>SW_SYNC</name>
                                <description> 软件强制同步（写清） 'b0:无影响 'b1:写1产生软件强制同步 </description>
                                <bitOffset>9</bitOffset>
                                <bitWidth>1</bitWidth>
                                <access>read-write</access>
                                <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                            </field>
                            

                            <field>
                                <name>SYNC_IN_EN</name>
                                <description> Sync in模式选择 'b0:关闭sync_in进来的信号 'b1:使能sync_in进来的信号 </description>
                                <bitOffset>8</bitOffset>
                                <bitWidth>1</bitWidth>
                                <access>read-write</access>
                                <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                            </field>
                            

                            <field>
                                <name>SYNC_SRC_SEL</name>
                                <description> 同步输入源选择 选择SPWM、INPUTXBAR、ETIM的同步信号，如下所示： 'd0:SPWM0_SYNC 'd1:SPWM1_SYNC 'd2:SPWM2_SYNC 'd3:SPWM3_SYNC 'd4:SPWM4_SYNC 'd5:SPWM5_SYNC 'd6:SPWM6_SYNC 'd7:SPWM7_SYNC 'd8:SPWM8_SYNC 'd9:SPWM9_SYNC 'd10:SPWM10_SYNC 'd11: SPWM11_SYNC d12: SPWM12_SYNC 'd13: SPWM13_SYNC 'd14: SPWM14_SYNC 'd15: SPWM15_SYNC 'd16: SPWM16_SYNC 'd17: SPWM17_SYNC 'd18:INPUTXBAR0(XBAR CAP输入源低6位) 'd19: INPUTXBAR1(XBAR CAP输入源低6位) 'd20: INPUTXBAR2(XBAR CAP输入源低6位) 'd21: INPUTXBAR3(XBAR CAP输入源低6位) 'd22: INPUTXBAR4(XBAR CAP输入源低6位) 'd23: INPUTXBAR5(XBAR CAP输入源低6位) 'd24:ETIM0_SYNC_OUT 'd25:ETIM1_SYNC_OUT 'd26:ETIM2_SYNC_OUT 'd27:ETIM3_SYNC_OUT 'd28:ETIM4_SYNC_OUT 'd29:ETIM5_SYNC_OUT 'd30:ETIM6_SYNC_OUT 'd31:ETIM7_SYNC_OUT 'd32:ETIM8_SYNC_OUT 'd33:ETIM9_SYNC_OUT 'd34:ETIM10_SYNC_OUT 'd35:ETIM11_SYNC_OUT '36-63:1'b0' </description>
                                <bitOffset>0</bitOffset>
                                <bitWidth>6</bitWidth>
                                <access>read-write</access>
                                <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                            </field>
                            

                        </fields>
                    </register>
                    


                    <register>
                        <name>CAP_CTRL</name>
                        <description>CAP_CTRL</description>
                        <addressOffset>0x24</addressOffset>
                        <size>32</size>
                        <access>
                        read-write
                    </access>
                        <resetValue>0x03000000</resetValue>
                        <resetMask>0x1F7FFFFF</resetMask>
                        <fields>
                            

                            <field>
                                <name>CAP_REARM</name>
                                <description> 重新加载 'b0:无作用 'b1:针对one-shot模式 复位MOD4寄存器值到0，解冻MOD4计数器，使能CAP寄存器加载 </description>
                                <bitOffset>28</bitOffset>
                                <bitWidth>1</bitWidth>
                                <access>read-write</access>
                                <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                            </field>
                            

                            <field>
                                <name>CAP_MOD_STS</name>
                                <description> d0: CAP1寄存器在下一个捕获时刻加载 'd1: CAP2寄存器在下一个捕获时刻加载 'd2: CAP3寄存器在下一个捕获时刻加载 'd3: CAP4寄存器在下一个捕获时刻加载 </description>
                                <bitOffset>26</bitOffset>
                                <bitWidth>2</bitWidth>
                                <access>read-only</access>
                            </field>
                            

                            <field>
                                <name>CAP_STOP_WRAP</name>
                                <description> One-shot：停止计数值，停止时cap1~cap4寄存器将会被冻结 Continuous: 从该数开始重新进行计数 'd0:在捕获事件1发生后停止（one-shot）或者在捕获事件1后重新环绕 'd1:在捕获事件2发生后停止（one-shot）或者在捕获事件2后重新环绕 'd2:在捕获事件3发生后停止（one-shot）或者在捕获事件3后重新环绕 'd3:在捕获事件4发生后停止（one-shot）或者在捕获事件4后重新环绕 </description>
                                <bitOffset>24</bitOffset>
                                <bitWidth>2</bitWidth>
                                <access>read-write</access>
                                <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                            </field>
                            

                            <field>
                                <name>CAP_MODE</name>
                                <description> 捕获模式选择 'b0:continuous模式 'b1:one-shot模式 </description>
                                <bitOffset>22</bitOffset>
                                <bitWidth>1</bitWidth>
                                <access>read-write</access>
                                <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                            </field>
                            

                            <field>
                                <name>CAP_LOAD_EN</name>
                                <description> 加载CAP1~CAP4寄存器值 'b0:在捕获事件发生时，关闭加载CAP1~CAP4 'b1: 在捕获事件发生时，使能加载CAP1~CAP4 </description>
                                <bitOffset>21</bitOffset>
                                <bitWidth>1</bitWidth>
                                <access>read-write</access>
                                <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                            </field>
                            

                            <field>
                                <name>CAP_PRE_DIV</name>
                                <description> 配置CAP 预分频 'h0:by pass 'h1:预分频2 'h2:预分频4 'h3:预分频6 ...... 'h1e:预分频60 'h1f:预分频62 </description>
                                <bitOffset>16</bitOffset>
                                <bitWidth>5</bitWidth>
                                <access>read-write</access>
