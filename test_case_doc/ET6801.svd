                <register>
                    
                
                    <name>IC_ENABLE</name>
                    
                
                    <addressOffset>0x6c</addressOffset>
                    
                
                    <description>I2C Enable Register</description>
                    
                
                    <size>32</size>
                    
                
                    <access>read-write</access>
                    
                
                    <resetValue>0x00080000</resetValue>
                    
                
                    <resetMask>0xFFFFFFFF</resetMask>
                    
                
                    <fields>
                        
                    
                        <field>
                            
                        
                            <name>RSVD_IC_ENABLE_2</name>
                            
                        
                            <description> IC_ENABLE Reserved bits - Read Only</description>
                            
                        
                            <bitOffset>23</bitOffset>
                            
                        
                            <bitWidth>9</bitWidth>
                            
                        
                            <access>read-only</access>
                            
                    
                        </field>
                        
                    
                        <field>
                            
                        
                            <name>IC_SAR4_EN</name>
                            
                        
                            <description> Controls whether the DW_apb_i2c SAR4 is enabled.
                    If IC_SAR4_EN bit of the IC_ENABLE register is set to 1, 
                  then the DW_apb_i2c will acknowledge the address if it 
                  corresponds to IC_SAR4 and completes the I2C transfers as 
                  intended.
                  Otherwise, the I2C transfer address will be Nacked.</description>
                            
                        
                            <bitOffset>22</bitOffset>
                            
                        
                            <bitWidth>1</bitWidth>
                            
                        
                            <access>read-only</access>
                            
                    
                        </field>
                        
                    
                        <field>
                            
                        
                            <name>IC_SAR3_EN</name>
                            
                        
                            <description> Controls whether the DW_apb_i2c SAR3 is enabled.
                    If IC_SAR3_EN bit of the IC_ENABLE register is set to 1, 
                  then the DW_apb_i2c will acknowledge the address if it 
                  corresponds to IC_SAR3 and completes the I2C transfers as 
                  intended.
                  Otherwise, the I2C transfer address will be Nacked.</description>
                            
                        
                            <bitOffset>21</bitOffset>
                            
                        
                            <bitWidth>1</bitWidth>
                            
                        
                            <access>read-only</access>
                            
                    
                        </field>
                        
                    
                        <field>
                            
                        
                            <name>IC_SAR2_EN</name>
                            
                        
                            <description>Controls whether the DW_apb_i2c SAR2 is enabled.
                    If IC_SAR2_EN bit of the IC_ENABLE register is set to 1, 
                  then the DW_apb_i2c will acknowledge the address if it 
                  corresponds to IC_SAR2 and completes the I2C transfers as 
                  intended.
                  Otherwise, the I2C transfer address will be Nacked.</description>
                            
                        
                            <bitOffset>20</bitOffset>
                            
                        
                            <bitWidth>1</bitWidth>
                            
                        
                            <access>read-write</access>
                            
                        
                            <modifiedWriteValues>
                        modify
                    </modifiedWriteValues>
                            
                    
                        </field>
                        
                    
                        <field>
                            
                        
                            <name>IC_SAR_EN</name>
                            
                        
                            <description> Controls whether the DW_apb_i2c SAR is enabled.
                    If IC_SAR_EN bit of the IC_ENABLE register is set to 1, 
                  then the DW_apb_i2c will acknowledge the address if it 
                  corresponds to IC_SAR and completes the I2C transfers as 
                  intended.
                  Otherwise, the I2C transfer address will be Nacked</description>
                            
                        
                            <bitOffset>19</bitOffset>
                            
                        
                            <bitWidth>1</bitWidth>
                            
                        
                            <access>read-write</access>
                            
                        
                            <modifiedWriteValues>
                        modify
                    </modifiedWriteValues>
                            
                    
                        </field>
                        
                    
                        <field>
                            
                        
                            <name>SMBUS_ALERT_EN</name>
                            
                        
                            <description>The SMBUS_ALERT_CTRL register bit is used to control 
                  assertion of SMBALERT signal.</description>
                            
                        
                            <bitOffset>18</bitOffset>
                            
                        
                            <bitWidth>1</bitWidth>
                            
                        
                            <access>read-write</access>
                            
                        
                            <modifiedWriteValues>
                        modify
                    </modifiedWriteValues>
                            
                    
                        </field>
                        
                    
                        <field>
                            
                        
                            <name>SMBUS_SUSPEND_EN</name>
                            
                        
                            <description>The SMBUS_SUSPEND_EN register bit is used to control 
                  assertion and de-assertion of SMBSUS signal.</description>
                            
                        
                            <bitOffset>17</bitOffset>
                            
                        
                            <bitWidth>1</bitWidth>
                            
                        
                            <access>read-write</access>
                            
                        
                            <modifiedWriteValues>
                        modify
                    </modifiedWriteValues>
                            
                    
                        </field>
                        
                    
                        <field>
                            
                        
                            <name>SMBUS_CLK_RESET</name>
                            
                        
                            <description> This bit is used in SMBus Host mode to initiate the SMBus 
                  Master Clock Reset. This bit should be enabled only when 
                  Master is in idle. Whenever this bit is enabled, the SMBCLK 
                  is held low for the IC_SCL_STUCK_TIMEOUT ic_clk cycles 
                  to reset the SMBus slave devices.</description>
                            
                        
                            <bitOffset>16</bitOffset>
                            
                        
                            <bitWidth>1</bitWidth>
                            
                        
                            <access>read-write</access>
                            
                        
                            <modifiedWriteValues>
                        modify
                    </modifiedWriteValues>
                            
                    
                        </field>
                        
                    
                        <field>
                            
                        
                            <name>RSVD_IC_ENABLE_1</name>
                            
                        
                            <description>RSVD_IC_ENABLE_1 Reserved bits - Read Only</description>
                            
                        
                            <bitOffset>4</bitOffset>
                            
                        
                            <bitWidth>12</bitWidth>
                            
                        
                            <access>read-only</access>
                            
                    
                        </field>
                        
                    
                        <field>
                            
                        
                            <name>SDA_STUCK_RECOVERY_ENABLE</name>
                            
                        
                            <description> If SDA is stuck at low indicated through the TX_ABORT 
                  interrupt (IC_TX_ABRT_SOURCE[17]), then this bit is used 
                  as a control knob to initiate the SDA Recovery Mechanism 
                  (that is, send at most 9 SCL clocks and STOP to release the 
                  SDA line) and then this bit gets auto clear</description>
                            
                        
                            <bitOffset>3</bitOffset>
                            
                        
                            <bitWidth>1</bitWidth>
                            
                        
                            <access>read-write</access>
                            
                        
                            <modifiedWriteValues>
                        modify
                    </modifiedWriteValues>
                            
                    
                        </field>
                        
                    
                        <field>
                            
                        
                            <name>TX_CMD_BLOCK</name>
                            
                        
                            <description> In Master mode</description>
                            
                        
                            <bitOffset>2</bitOffset>
                            
                        
                            <bitWidth>1</bitWidth>
                            
                        
                            <access>read-write</access>
                            
                        
                            <modifiedWriteValues>
                        modify
                    </modifiedWriteValues>
                            
                    
                        </field>
                        
                    
                        <field>
                            
                        
                            <name>ABORT</name>
                            
                        
                            <description> When set, the controller initiates the transfer abort.</description>
                            
                        
                            <bitOffset>1</bitOffset>
                            
                        
                            <bitWidth>1</bitWidth>
                            
                        
                            <access>read-write</access>
                            
                        
                            <modifiedWriteValues>
                        modify
                    </modifiedWriteValues>
                            
                    
                        </field>
                        
                    
                        <field>
                            
                        
                            <name>ENABLE</name>
                            
                        
                            <description>Controls whether the DW_apb_i2c is enabled.</description>
                            
                        
                            <bitOffset>0</bitOffset>
                            
                        
                            <bitWidth>1</bitWidth>
                            
                        
                            <access>read-write</access>
                            
                        
                            <modifiedWriteValues>
                        modify
                    </modifiedWriteValues>
                            
                    
                        </field>
                        
                
                    </fields>
                    
            
                </register>
                
            
                <register>
                    
                
                    <name>IC_STATUS</name>
                    
                
                    <addressOffset>0x70</addressOffset>
                    
                
                    <description>I2C Status Register.</description>
                    
                
                    <size>32</size>
                    
                
                    <access>read-only</access>
                    
                
                    <resetValue>0x00220006</resetValue>
                    
                
                    <resetMask>0xFFFFFFFF</resetMask>
                    
                
                    <fields>
                        
                    
                        <field>
                            
                        
                            <name>RSVD_IC_STATUS_2</name>
                            
                        
                            <description>IC_STATUS Reserved bits - Read Only</description>
                            
                        
                            <bitOffset>27</bitOffset>
                            
                        
                            <bitWidth>5</bitWidth>
                            
                        
                            <access>read-only</access>
                            
                    
                        </field>
                        
                    
                        <field>
                            
                        
                            <name>SMBUS_SLAVE_ADDR4_RESOLVED</name>
                            
                        
                            <description> This bit indicates whether the slave address 4 (IC_SAR4) is 
                  resolved by the ARP Master.</description>
                            
                        
                            <bitOffset>26</bitOffset>
                            
                        
                            <bitWidth>1</bitWidth>
                            
                        
                            <access>read-only</access>
                            
                    
                        </field>
                        
                    
                        <field>
                            
                        
                            <name>SMBUS_SLAVE_ADDR4_VALID</name>
                            
                        
                            <description>This bit indicates whether the slave address 4 (IC_SAR4) is 
                  valid or not.</description>
                            
                        
                            <bitOffset>25</bitOffset>
                            
                        
                            <bitWidth>1</bitWidth>
                            
                        
                            <access>read-only</access>
                            
                    
                        </field>
                        
                    
                        <field>
                            
                        
                            <name>SMBUS_SLAVE_ADDR3_RESOLVED</name>
                            
                        
                            <description> This bit indicates whether the slave address 3 (IC_SAR3) is 
                  resolved by the ARP Master.</description>
                            
                        
                            <bitOffset>24</bitOffset>
                            
                        
                            <bitWidth>1</bitWidth>
                            
                        
                            <access>read-only</access>
                            
                    
                        </field>
                        
                    
                        <field>
                            
                        
                            <name>SMBUS_SLAVE_ADDR3_VALID</name>
                            
                        
                            <description>This bit indicates whether the slave address 3 (IC_SAR3) is 
                  valid or not.</description>
                            
                        
                            <bitOffset>23</bitOffset>
                            
                        
                            <bitWidth>1</bitWidth>
                            
                        
                            <access>read-only</access>
                            
                    
                        </field>
                        
                    
                        <field>
                            
                        
                            <name>SMBUS_SLAVE_ADDR2_RESOLVED</name>
                            
                        
                            <description>This bit indicates whether the slave address 2 (IC_SAR2) is 
                  resolved by the ARP Master.</description>
                            
                        
                            <bitOffset>22</bitOffset>
                            
                        
                            <bitWidth>1</bitWidth>
                            
                        
                            <access>read-only</access>
                            
                    
                        </field>
                        
                    
                        <field>
                            
                        
                            <name>SMBUS_SLAVE_ADDR2_VALID</name>
                            
                        
                            <description> This bit indicates whether the slave address 2 (IC_SAR2) is 
                  valid or not.</description>
                            
                        
                            <bitOffset>21</bitOffset>
                            
                        
                            <bitWidth>1</bitWidth>
                            
                        
                            <access>read-only</access>
                            
                    
                        </field>
                        
                    
                        <field>
                            
                        
                            <name>SMBUS_ALERT_STATUS</name>
                            
                        
                            <description>This bit indicates the status of the SMBus Alert signal 
                  (ic_smbalert_in_n). This signal is asserted when the SMBus 
                  Alert signal is asserted by the SMBus Device.</description>
                            
                        
                            <bitOffset>20</bitOffset>
                            
                        
                            <bitWidth>1</bitWidth>
                            
                        
                            <access>read-only</access>
                            
                    
                        </field>
                        
                    
                        <field>
                            
                        
                            <name>SMBUS_SUSPEND_STATUS</name>
                            
                        
                            <description> This bit indicates the status of the SMBus Suspend signal 
                  (ic_smbsus_in_n). This signal is asserted when the SMBus 
                  Suspend signal is asserted by the SMBus Host.</description>
                            
                        
                            <bitOffset>19</bitOffset>
                            
                        
                            <bitWidth>1</bitWidth>
                            
                        
                            <access>read-only</access>
                            
                    
                        </field>
                        
                    
                        <field>
                            
                        
                            <name>SMBUS_SLAVE_ADDR_RESOLVED</name>
                            
                        
                            <description> This bit indicates whether the slave address (ic_sar) is 
                  resolved by the ARP Master.</description>
                            
                        
                            <bitOffset>18</bitOffset>
                            
                        
                            <bitWidth>1</bitWidth>
                            
                        
                            <access>read-only</access>
                            
                    
                        </field>
                        
                    
                        <field>
                            
                        
                            <name>SMBUS_SLAVE_ADDR_VALID</name>
                            
                        
                            <description> This bit indicates whether the slave address (ic_sar) is valid 
                  or not.</description>
                            
                        
                            <bitOffset>17</bitOffset>
                            
                        
                            <bitWidth>1</bitWidth>
                            
                        
                            <access>read-only</access>
                            
                    
                        </field>
                        
                    
                        <field>
                            
                        
                            <name>SMBUS_QUICK_CMD_BIT</name>
                            
                        
                            <description> This bit indicates the read-write bit of the Quick command 
                  received. This bit will be cleared after the user has read this 
                  bit.</description>
                            
                        
                            <bitOffset>16</bitOffset>
                            
                        
                            <bitWidth>1</bitWidth>
                            
                        
                            <access>read-only</access>
                            
                    
                        </field>
                        
                    
                        <field>
                            
                        
                            <name>RSVD_IC_STATUS_1</name>
                            
                        
                            <description> RSVD_IC_STATUS_1 Reserved bits - Read Only</description>
                            
                        
                            <bitOffset>13</bitOffset>
                            
                        
                            <bitWidth>3</bitWidth>
                            
                        
                            <access>read-only</access>
                            
                    
                        </field>
                        
                    
                        <field>
                            
                        
                            <name>SLV_ISO_SAR_DATA_CLK_STRETCH</name>
                            
                        
                            <description>This bit indicates the Bus hold (clock stretching) in Slave 
                  mode with Multiple SAR feature - for isolating the write 
                  transfer related data corresponding to one slave address 
                  with another slave address.</description>
                            
                        
                            <bitOffset>12</bitOffset>
                            
                        
                            <bitWidth>1</bitWidth>
                            
                        
                            <access>read-only</access>
                            
                    
                        </field>
                        
                    
                        <field>
                            
                        
                            <name>SDA_STUCK_NOT_RECOVERED</name>
                            
                        
                            <description> This bit indicates that SDA stuck at low is not recovered after 
                  the recovery mechanism. In Slave mode, this register bit is 
                  not applicable.</description>
                            
                        
                            <bitOffset>11</bitOffset>
                            
                        
                            <bitWidth>1</bitWidth>
                            
                        
                            <access>read-only</access>
                            
                    
                        </field>
                        
                    
                        <field>
                            
                        
                            <name>SLV_HOLD_RX_FIFO_FULL</name>
                            
                        
                            <description>This bit indicates the BUS Hold in Slave mode due to Rx 
                  FIFO is Full and an additional byte has been received (This 
                  kind of Bus hold is applicable</description>
                            
                        
                            <bitOffset>10</bitOffset>
                            
                        
                            <bitWidth>1</bitWidth>
                            
                        
                            <access>read-only</access>
                            
                    
                        </field>
                        
                    
                        <field>
                            
                        
                            <name>SLV_HOLD_TX_FIFO_EMPTY</name>
                            
                        
                            <description>This bit indicates the BUS Hold in Slave mode for the Read 
                  request when the Tx FIFO is empty. The Bus is in hold until 
                  the Tx FIFO has data to Transmit for the read request.</description>
                            
                        
                            <bitOffset>9</bitOffset>
                            
                        
                            <bitWidth>1</bitWidth>
                            
                        
                            <access>read-only</access>
                            
                    
                        </field>
                        
                    
                        <field>
                            
                        
                            <name>MST_HOLD_RX_FIFO_FULL</name>
                            
                        
                            <description> This bit indicates the BUS Hold in Master mode due to Rx 
                  FIFO is Full and additional byte has been received (This kind 
                  of Bus hold is applicable</description>
                            
                        
                            <bitOffset>8</bitOffset>
                            
                        
                            <bitWidth>1</bitWidth>
                            
                        
                            <access>read-only</access>
                            
                    
                        </field>
                        
                    
                        <field>
                            
                        
                            <name>MST_HOLD_TX_FIFO_EMPTY</name>
                            
                        
                            <description> If the IC_EMPTYFIFO_HOLD_MASTER_EN parameter is 
                  set to 1, the DW_apb_i2c master stalls the write transfer 
                  when Tx FIFO is empty, and the the last byte does not have 
                  the Stop bit set. This bit indicates the BUS hold when the 
                  master holds the bus because of the Tx FIFO being empty, 
                  and the the previous transferred command does not have the 
                  Stop bit set.</description>
                            
                        
                            <bitOffset>7</bitOffset>
                            
                        
                            <bitWidth>1</bitWidth>
                            
                        
                            <access>read-only</access>
                            
                    
                        </field>
                        
                    
                        <field>
                            
                        
                            <name>SLV_ACTIVITY</name>
                            
                        
                            <description>Slave FSM Activity Status. When the Slave Finite State 
                  Machine (FSM) is not in the IDLE state, this bit is set.</description>
                            
                        
                            <bitOffset>6</bitOffset>
                            
                        
                            <bitWidth>1</bitWidth>
                            
                        
                            <access>read-only</access>
                            
                    
                        </field>
                        
                    
                        <field>
                            
                        
                            <name>MST_ACTIVITY</name>
                            
                        
                            <description>Master FSM Activity Status. When the Master Finite State 
                  Machine (FSM) is not in the IDLE state, this bit is set.</description>
                            
                        
                            <bitOffset>5</bitOffset>
                            
                        
                            <bitWidth>1</bitWidth>
                            
                        
                            <access>read-only</access>
                            
                    
                        </field>
                        
                    
                        <field>
                            
                        
                            <name>RFF</name>
                            
                        
                            <description>Receive FIFO Completely Full. When the receive FIFO is 
                  completely full, this bit is set. When the receive FIFO 
                  contains one or more empty location, this bit is cleared.</description>
                            
                        
                            <bitOffset>4</bitOffset>
                            
                        
                            <bitWidth>1</bitWidth>
                            
                        
                            <access>read-only</access>
                            
                    
                        </field>
                        
                    
                        <field>
                            
                        
                            <name>RFNE</name>
                            
                        
                            <description>Receive FIFO Not Empty. This bit is set when the receive 
                  FIFO contains one or more entries; it is cleared when the 
                  receive FIFO is empty.</description>
                            
                        
                            <bitOffset>3</bitOffset>
                            
                        
                            <bitWidth>1</bitWidth>
                            
                        
                            <access>read-only</access>
                            
                    
                        </field>
                        
                    
                        <field>
                            
                        
                            <name>TFE</name>
                            
                        
                            <description> Transmit FIFO Completely Empty. When the transmit FIFO is 
                  completely empty, this bit is set. When it contains one or 
                  more valid entries, this bit is cleared. This bit field does not 
                  request an interrupt.</description>
                            
                        
                            <bitOffset>2</bitOffset>
                            
                        
                            <bitWidth>1</bitWidth>
                            
                        
                            <access>read-only</access>
                            
                    
                        </field>
                        
                    
                        <field>
                            
                        
                            <name>TFNF</name>
                            
                        
                            <description> Transmit FIFO Not Full. Set when the transmit FIFO contains 
                  one or more empty locations, and is cleared when the FIFO 
                  is full.</description>
                            
                        
                            <bitOffset>1</bitOffset>
                            
                        
                            <bitWidth>1</bitWidth>
                            
                        
                            <access>read-only</access>
                            
                    
                        </field>
                        
                    
                        <field>
                            
                        
                            <name>ACTIVITY</name>
                            
                        
                            <description> I2C Activity Status.</description>
                            
                        
                            <bitOffset>0</bitOffset>
                            
                        
                            <bitWidth>1</bitWidth>
                            
                        
                            <access>read-only</access>
                            
                    
                        </field>
                        
                
                    </fields>
                    
            
                </register>
                
            
                <register>
                    
                
                    <name>IC_TXFLR</name>
                    
                
                    <addressOffset>0x74</addressOffset>
                    
                
                    <description> I2C Transmit FIFO Level Register.</description>
                    
                
                    <size>32</size>
                    
                
                    <access>read-only</access>
                    
                
                    <resetValue>0x00000000</resetValue>
                    
                
                    <resetMask>0xFFFFFFFF</resetMask>
                    
                
                    <fields>
                        
                    
                        <field>
                            
                        
                            <name>RSVD_TXFLR</name>
                            
                        
                            <description>TXFLR Register field Reserved bits - Read Only</description>
                            
                        
                            <bitOffset>6</bitOffset>
                            
                        
                            <bitWidth>26</bitWidth>
                            
                        
                            <access>read-only</access>
                            
                    
                        </field>
                        
                    
                        <field>
                            
                        
                            <name>TXFLR</name>
                            
                        
                            <description>Transmit FIFO Level. Contains the number of valid data 
                  entries in the transmit FIFO.</description>
                            
                        
                            <bitOffset>0</bitOffset>
                            
                        
                            <bitWidth>6</bitWidth>
                            
                        
                            <access>read-only</access>
                            
                    
                        </field>
                        
                
                    </fields>
                    
            
                </register>
                
            
                <register>
                    
                
                    <name>IC_RXFLR</name>
                    
                
                    <addressOffset>0x78</addressOffset>
                    
                
                    <description>I2C Receive FIFO Level Register.</description>
                    
                
                    <size>32</size>
                    
                
                    <access>read-only</access>
                    
                
                    <resetValue>0x00000000</resetValue>
                    
                
                    <resetMask>0xFFFFFFFF</resetMask>
                    
                
                    <fields>
                        
                    
                        <field>
                            
                        
                            <name>RSVD_RXFLR</name>
                            
                        
                            <description> RXFLR Reserved bits - Read Only</description>
                            
                        
                            <bitOffset>6</bitOffset>
                            
                        
                            <bitWidth>26</bitWidth>
                            
                        
                            <access>read-only</access>
                            
                    
                        </field>
                        
                    
                        <field>
                            
                        
                            <name>RXFLR</name>
                            
                        
                            <description>Receive FIFO Level. Contains the number of valid data 
                  entries in the receive FIFO.</description>
                            
                        
                            <bitOffset>0</bitOffset>
                            
                        
                            <bitWidth>6</bitWidth>
                            
                        
                            <access>read-only</access>
                            
                    
                        </field>
                        
                
                    </fields>
                    
            
                </register>
                
            
                <register>
                    
                
                    <name>IC_SDA_HOLD</name>
                    
                
                    <addressOffset>0x7c</addressOffset>
                    
                
                    <description>I2C SDA Hold Time Length Register.</description>
                    
                
                    <size>32</size>
                    
                
                    <access>read-write</access>
                    
                
                    <resetValue>0x00000001</resetValue>
                    
                
                    <resetMask>0xFFFFFFFF</resetMask>
                    
                
                    <fields>
                        
                    
                        <field>
                            
                        
                            <name>RSVD_IC_SDA_HOLD</name>
                            
                        
                            <description>IC_SDA_HOLD Reserved bits - Read Only</description>
                            
                        
                            <bitOffset>24</bitOffset>
                            
                        
                            <bitWidth>8</bitWidth>
                            
                        
                            <access>read-only</access>
                            
                    
                        </field>
                        
                    
                        <field>
                            
                        
                            <name>IC_SDA_RX_HOLD</name>
                            
                        
                            <description>Sets the required SDA hold time in units of ic_clk period, 
                  when DW_apb_i2c acts as a receiver.</description>
                            
                        
                            <bitOffset>16</bitOffset>
                            
                        
                            <bitWidth>8</bitWidth>
                            
                        
                            <access>read-write</access>
                            
                        
                            <modifiedWriteValues>
                        modify
                    </modifiedWriteValues>
                            
                    
                        </field>
                        
                    
                        <field>
                            
                        
                            <name>IC_SDA_TX_HOLD</name>
                            
                        
                            <description>Sets the required SDA hold time in units of ic_clk period, 
                  when DW_apb_i2c acts as a transmitter.</description>
                            
                        
                            <bitOffset>0</bitOffset>
                            
                        
                            <bitWidth>16</bitWidth>
                            
                        
                            <access>read-write</access>
                            
                        
                            <modifiedWriteValues>
                        modify
                    </modifiedWriteValues>
                            
                    
                        </field>
                        
                
                    </fields>
                    
            
                </register>
                
            
                <register>
                    
                
                    <name>IC_TX_ABRT_SOURCE</name>
                    
                
                    <addressOffset>0x80</addressOffset>
                    
                
                    <description>I2C Transmit Abort Source Register.</description>
                    
                
                    <size>32</size>
                    
                
                    <access>read-only</access>
                    
                
                    <resetValue>0x00000000</resetValue>
                    
                
                    <resetMask>0xFFFFFFFF</resetMask>
                    
                
                    <fields>
                        
                    
                        <field>
                            
                        
                            <name>TX_FLUSH_CNT</name>
                            
                        
                            <description>This field indicates the number of Tx FIFO Data Commands 
                  which are flushed due to TX_ABRT interrupt. It is cleared 
                  whenever I2C is disabled.</description>
                            
                        
                            <bitOffset>23</bitOffset>
                            
                        
                            <bitWidth>9</bitWidth>
                            
                        
                            <access>read-only</access>
                            
                    
                        </field>
                        
                    
                        <field>
                            
                        
                            <name>RSVD_IC_TX_ABRT_SOURCE</name>
                            
                        
                            <description> IC_TX_ABRT_SOURCE Reserved bits - Read Only</description>
                            
                        
                            <bitOffset>21</bitOffset>
                            
                        
                            <bitWidth>2</bitWidth>
                            
                        
                            <access>read-only</access>
                            
                    
                        </field>
                        
                    
                        <field>
                            
                        
                            <name>ABRT_DEVICE_WRITE</name>
                            
                        
                            <description>This is a master-mode-only bit. Master is initiating the 
                  DEVICE_ID transfer and the Tx-FIFO consists of write 
                  commands.</description>
                            
                        
                            <bitOffset>20</bitOffset>
                            
                        
                            <bitWidth>1</bitWidth>
                            
                        
                            <access>read-only</access>
                            
                    
                        </field>
                        
                    
                        <field>
                            
                        
                            <name>ABRT_DEVICE_SLVADDR_NOACK</name>
                            
                        
                            <description>This is a master-mode-only bit. Master is initiating the 
                  DEVICE_ID transfer and the slave address sent was not 
                  acknowledged by any slave.</description>
                            
                        
                            <bitOffset>19</bitOffset>
                            
                        
                            <bitWidth>1</bitWidth>
                            
                        
                            <access>read-only</access>
                            
                    
                        </field>
                        
                    
                        <field>
                            
                        
                            <name>ABRT_DEVICE_NOACK</name>
                            
                        
                            <description>This is a master-mode-only bit. Master is initiating the 
                  DEVICE_ID transfer and the device id sent was not 
                  acknowledged by any slave.</description>
                            
                        
                            <bitOffset>18</bitOffset>
                            
                        
                            <bitWidth>1</bitWidth>
                            
                        
                            <access>read-only</access>
                            
                    
                        </field>
                        
                    
                        <field>
                            
                        
                            <name>ABRT_SDA_STUCK_AT_LOW</name>
                            
                        
                            <description>This is a master-mode-only bit. Master detects the SDA 
                  Stuck at low for the IC_SDA_STUCK_AT_LOW_TIMEOUT 
                  value of ic_clks.</description>
                            
                        
                            <bitOffset>17</bitOffset>
                            
                        
                            <bitWidth>1</bitWidth>
                            
                        
                            <access>read-only</access>
                            
                    
                        </field>
                        
                    
                        <field>
                            
                        
                            <name>ABRT_USER_ABRT</name>
                            
                        
                            <description>This is a master-mode-only bit. Master has detected the 
                  transfer abort</description>
                            
                        
                            <bitOffset>16</bitOffset>
                            
                        
                            <bitWidth>1</bitWidth>
                            
                        
                            <access>read-only</access>
                            
                    
                        </field>
                        
                    
                        <field>
                            
                        
                            <name>ABRT_SLVRD_INTX</name>
                            
                        
                            <description>When the processor side responds to a slave mode request 
                  for data to be transmitted to a remote master and user writes 
                  a 1 in CMD (bit 8) of IC_DATA_CMD register.</description>
                            
                        
                            <bitOffset>15</bitOffset>
                            
                        
                            <bitWidth>1</bitWidth>
                            
                        
                            <access>read-only</access>
                            
                    
                        </field>
                        
                    
                        <field>
                            
                        
                            <name>ABRT_SLV_ARBLOST</name>
                            
                        
                            <description>This field indicates that a Slave has lost the bus while 
                  transmitting data to a remote master.</description>
                            
                        
                            <bitOffset>14</bitOffset>
                            
                        
                            <bitWidth>1</bitWidth>
                            
                        
                            <access>read-only</access>
                            
                    
                        </field>
                        
                    
                        <field>
                            
                        
                            <name>ABRT_SLVFLUSH_TXFIFO</name>
                            
                        
                            <description>This field specifies that the Slave has received a read 
                  command and some data exists in the TX FIFO, so the slave 
                  issues a TX_ABRT interrupt to flush old data in TX FIFO.</description>
                            
                        
                            <bitOffset>13</bitOffset>
                            
                        
                            <bitWidth>1</bitWidth>
                            
                        
                            <access>read-only</access>
                            
                    
                        </field>
                        
                    
                        <field>
                            
                        
                            <name>ARB_LOST</name>
                            
                        
                            <description> This field specifies that the Master has lost arbitration, or if 
                  IC_TX_ABRT_SOURCE[14] is also set, then the slave 
                  transmitter has lost arbitration.</description>
                            
                        
                            <bitOffset>12</bitOffset>
                            
                        
                            <bitWidth>1</bitWidth>
                            
                        
                            <access>read-only</access>
                            
                    
                        </field>
                        
                    
                        <field>
                            
                        
                            <name>ABRT_MASTER_DIS</name>
                            
                        
                            <description> This field indicates that the User tries to initiate a Master 
                  operation with the Master mode disabled.</description>
                            
                        
                            <bitOffset>11</bitOffset>
                            
                        
                            <bitWidth>1</bitWidth>
                            
                        
                            <access>read-only</access>
                            
                    
                        </field>
                        
                    
                        <field>
                            
                        
                            <name>ABRT_10B_RD_NORSTRT</name>
                            
                        
                            <description> This field indicates that the restart is disabled 
                  (IC_RESTART_EN bit (IC_CON[5]) =0) and the master 
                  sends a read command in 10-bit addressing mode.</description>
                            
                        
                            <bitOffset>10</bitOffset>
                            
                        
                            <bitWidth>1</bitWidth>
                            
                        
                            <access>read-only</access>
                            
                    
                        </field>
                        
                    
                        <field>
                            
                        
                            <name>ABRT_SBYTE_NORSTRT</name>
                            
                        
                            <description> To clear Bit 9, the source of the ABRT_SBYTE_NORSTRT 
                  must be fixed first; restart must be enabled (IC_CON[5]=1), 
                  the SPECIAL bit must be cleared (IC_TAR[11]), or the 
                  GC_OR_START bit must be cleared (IC_TAR[10]). Once the 
                  source of the ABRT_SBYTE_NORSTRT is fixed, then this bit 
                  can be cleared in the same manner as other bits in this 
                  register. If the source of the ABRT_SBYTE_NORSTRT is not 
                  fixed before attempting to clear this bit, bit 9 clears for one 
                  cycle and then gets reasserted. When this field is set to 1, 
                  the restart is disabled (IC_RESTART_EN bit (IC_CON[5]) 
                  =0) and the user is trying to send a START Byte.</description>
                            
                        
                            <bitOffset>9</bitOffset>
                            
                        
                            <bitWidth>1</bitWidth>
                            
                        
                            <access>read-only</access>
                            
                    
                        </field>
                        
                    
                        <field>
                            
                        
                            <name>ABRT_HS_NORSTRT</name>
                            
                        
                            <description>This field indicates that the restart is disabled 
                  (IC_RESTART_EN bit (IC_CON[5]) =0) and the user is trying 
                  to use the master to transfer data in High Speed mode.</description>
                            
                        
                            <bitOffset>8</bitOffset>
                            
                        
                            <bitWidth>1</bitWidth>
                            
                        
                            <access>read-only</access>
                            
                    
                        </field>
                        
                    
                        <field>
                            
                        
                            <name>ABRT_SBYTE_ACKDET</name>
                            
                        
                            <description>This field indicates that the Master has sent a START Byte 
                  and the START Byte was acknowledged (wrong behavior).</description>
                            
                        
                            <bitOffset>7</bitOffset>
                            
                        
                            <bitWidth>1</bitWidth>
                            
                        
                            <access>read-only</access>
                            
                    
                        </field>
                        
                    
                        <field>
                            
                        
                            <name>ABRT_HS_ACKDET</name>
                            
                        
                            <description> This field indicates that the Master is in High Speed mode 
                  and the High Speed Master code was acknowledged (wrong 
                  behavior).</description>
                            
                        
                            <bitOffset>6</bitOffset>
                            
                        
                            <bitWidth>1</bitWidth>
                            
                        
                            <access>read-only</access>
                            
                    
                        </field>
                        
                    
                        <field>
                            
                        
                            <name>ABRT_GCALL_READ</name>
                            
                        
                            <description>This field indicates that DW_apb_i2c in the master mode has 
                  sent a General Call but the user programmed the byte 
                  following the General Call to be a read from the bus</description>
                            
                        
                            <bitOffset>5</bitOffset>
                            
                        
                            <bitWidth>1</bitWidth>
                            
                        
                            <access>read-only</access>
                            
                    
                        </field>
                        
                    
                        <field>
                            
                        
                            <name>ABRT_GCALL_NOACK</name>
                            
                        
                            <description>This field indicates that DW_apb_i2c in master mode has 
                  sent a General Call and no slave on the bus acknowledged 
                  the General Call.</description>
                            
                        
                            <bitOffset>4</bitOffset>
                            
                        
                            <bitWidth>1</bitWidth>
                            
                        
                            <access>read-only</access>
                            
                    
                        </field>
                        
                    
                        <field>
                            
                        
                            <name>ABRT_TXDATA_NOACK</name>
                            
                        
                            <description> This field indicates the master-mode only bit. When the 
                  master receives an acknowledgement for the address, but 
                  when it sends data byte(s) following the address, it did not 
                  receive an acknowledge from the remote slave(s).</description>
                            
                        
                            <bitOffset>3</bitOffset>
                            
                        
                            <bitWidth>1</bitWidth>
                            
                        
                            <access>read-only</access>
                            
                    
                        </field>
                        
                    
                        <field>
                            
                        
                            <name>ABRT_10ADDR2_NOACK</name>
                            
                        
                            <description> This field indicates that the Master is in 10-bit address mode 
                  and that the second address byte of the 10-bit address was 
                  not acknowledged by any slave.</description>
                            
                        
                            <bitOffset>2</bitOffset>
                            
                        
                            <bitWidth>1</bitWidth>
                            
                        
                            <access>read-only</access>
                            
                    
                        </field>
                        
                    
                        <field>
                            
                        
                            <name>ABRT_10ADDR1_NOACK</name>
                            
                        
                            <description> This field indicates that the Master is in 10-bit address mode 
                  and the first 10-bit address byte was not acknowledged by 
                  any slave.</description>
                            
                        
                            <bitOffset>1</bitOffset>
                            
                        
                            <bitWidth>1</bitWidth>
                            
                        
                            <access>read-only</access>
                            
                    
                        </field>
                        
                    
                        <field>
                            
                        
                            <name>ABRT_7B_ADDR_NOACK</name>
                            
                        
                            <description> This field indicates that the Master is in 7-bit addressing 
                  mode and the address sent was not acknowledged by any 
                  slave.</description>
                            
                        
                            <bitOffset>0</bitOffset>
                            
                        
                            <bitWidth>1</bitWidth>
                            
                        
                            <access>read-only</access>
                            
                    
                        </field>
                        
                
                    </fields>
                    
            
                </register>
                
            
                <register>
                    
                
                    <name>IC_SLV_DATA_NACK_ONLY</name>
                    
                
                    <addressOffset>0x84</addressOffset>
                    
                
                    <description>Generate Slave Data NACK Register</description>
                    
                
                    <size>32</size>
                    
                
                    <access>read-write</access>
                    
                
                    <resetValue>0x00000000</resetValue>
                    
                
                    <resetMask>0xFFFFFFFF</resetMask>
                    
                
                    <fields>
                        
                    
                        <field>
                            
                        
                            <name>RSVD_IC_SLV_DATA_NACK_ONLY</name>
                            
                        
                            <description>IC_SLV_DATA_NACK_ONLY Reserved bits - Read Only</description>
                            
                        
                            <bitOffset>1</bitOffset>
                            
                        
                            <bitWidth>31</bitWidth>
                            
                        
                            <access>read-only</access>
                            
                    
                        </field>
                        
                    
                        <field>
                            
                        
                            <name>NACK</name>
                            
                        
                            <description> Generate NACK. This NACK generation only occurs when 
                  DW_apb_i2c is a slave-receiver. If this register is set to a 
                  value of 1, it can only generate a NACK after a data byte is 
                  received; hence, the data transfer is aborted and the data 
                  received is not pushed to the receive buffer.</description>
                            
                        
                            <bitOffset>0</bitOffset>
                            
                        
                            <bitWidth>1</bitWidth>
                            
                        
                            <access>read-write</access>
                            
                        
                            <modifiedWriteValues>
                        modify
                    </modifiedWriteValues>
                            
                    
                        </field>
                        
                
                    </fields>
                    
            
                </register>
                
            
