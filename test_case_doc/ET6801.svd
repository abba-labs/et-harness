                    <fields>
                        

                        <field>
                            <name>CHECKSUM_INJECT</name>
                            <description> checksum校验和注错 bit4代表接收checksum注错，bit5代表发送checksum注错 0：不注错 1：1bit注错 </description>
                            <bitOffset>4</bitOffset>
                            <bitWidth>2</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>PARITY_INJECT</name>
                            <description> pid奇偶校验注错 bit0代表接收parity注错，bit1代表发送parity注错 0：不注错 1：1bit注错 </description>
                            <bitOffset>0</bitOffset>
                            <bitWidth>2</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                    </fields>
