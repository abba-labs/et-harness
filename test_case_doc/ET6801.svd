                    <register>
                        <name>PRSTRB</name>
                        <description>PRSTRB</description>
                        <addressOffset>0xd8</addressOffset>
                        <size>32</size>
                        <access>
                        read-write
                    </access>
                        <resetValue>0x00000000</resetValue>
                        <resetMask>0xFFFF003F</resetMask>
                        <fields>
                            

                            <field>
                                <name>RSTVAL</name>
                                <description> 当PRSTRB模块内16bit计数器达到该值时复位到0； 保护模式：LOCK 加载方式：静态加载 </description>
                                <bitOffset>16</bitOffset>
                                <bitWidth>16</bitWidth>
                                <access>read-write</access>
                                <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                            </field>
                            

                            <field>
                                <name>SIGSEL</name>
                                <description> MUX选择信号，选取计数器某一比特信号，例如 'b0000 = 选择计数器比特0，实际上对应时钟2分频 'b0001 = 选择计数器比特1，实际上对应时钟4分频 ... 'b1111 = 选择计数器比特15，实际上对应时钟2^16分频 保护模式：LOCK 加载方式：静态加载 </description>
                                <bitOffset>2</bitOffset>
                                <bitWidth>4</bitWidth>
                                <access>read-write</access>
                                <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                            </field>
                            

                            <field>
                                <name>MDSEL</name>
                                <description> clk/strobe选择信号 'b0 = prescale模块输出strobe。当计数器值等于prescale_value时产生strobe; 'b1 = 输出tap信号选择的计数器某位bit信号 保护模式：LOCK 加载方式：静态加载 </description>
                                <bitOffset>1</bitOffset>
                                <bitWidth>1</bitWidth>
                                <access>read-write</access>
                                <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                            </field>
                            

                            <field>
                                <name>EN</name>
                                <description> 使能预分频clk/strobe发生器 16 位计数器用于产生strobe或向 CLB CELL 发送选定的计数器位bit。通过一个 LCL_IN MUX 端口把strobe/预分频clk发送到 Tile，Tile 逻辑可根据需要选用。 clk/strobe选择信号 'b0 = prstrb模块输出为0；同时模块内计数器暂复位为0 'b1 = 输出tap信号选择的计数器某位bit信号 保护模式：LOCK 加载方式：静态加载 </description>
                                <bitOffset>0</bitOffset>
                                <bitWidth>1</bitWidth>
                                <access>read-write</access>
                                <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                            </field>
                            

                        </fields>
