                        </field>
                        
            
                        <field>
                            
                
                            <name>RFIFOR</name>
                            
                
                            <description>This resets the controlportion of the receive FIFO and treats the FIFO as empty. This will also de-assert the DMA RX request and single signals when additional DMA handshaking signals are selected.</description>
                            
                
                            <bitOffset>1</bitOffset>
                            
                
                            <bitWidth>1</bitWidth>
                            
                
