                    <addressOffset>0x0038</addressOffset>
                    <size>32</size>
                    <access>
                        read-write
                    </access>
                    <resetValue>0x30000007</resetValue>
                    <resetMask>0x73FFFFFF</resetMask>
                    <fields>
                        

                        <field>
                            <name>EFC_NOECC_RSV_SEL</name>
                            <description> ECC功能使能关闭时，8bit8全1插入位置选择： 0:除RSV3bi外，最高8bit，即3bit RSV+8bit ECC+ 64bit DATA； 1:最低8bit，即3bit RSV+64bit DATA+8bit ECC； </description>
                            <bitOffset>30</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>EFC_ECC_RD_RVS</name>
                            <description> ECC读翻转开启使能； </description>
                            <bitOffset>29</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>EFC_ECC_WR_RVS</name>
                            <description> ECC写翻转开启使能； Note:ECC读写翻转功能需要同时使能和不使能，并且在开启ECC写入数据之后，必须首先擦除数据才能修改，在开启ECC读写翻转时，可对擦除后的地址直接读取并且不会触发ECC错误告警。 </description>
                            <bitOffset>28</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>EFC_ECC_ERRGEN_ADDR</name>
                            <description> ECC错误注入对应地址 </description>
                            <bitOffset>8</bitOffset>
                            <bitWidth>18</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>EFC_ECC_ERRGEN_SEC</name>
                            <description> 地址对应sector范围； 1: NVR； 3: Main； other：reserved </description>
                            <bitOffset>6</bitOffset>
                            <bitWidth>2</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>EFC_ECC_ERRGEN_TYPE</name>
                            <description> ECC错误注入类型： 0：单bit错误； 1：2bit错误； other：更多bit错误； </description>
                            <bitOffset>4</bitOffset>
                            <bitWidth>2</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>EFC_ECC_ERRGEN_EN</name>
                            <description> ECC错误注入使能 1'b0：不打开ECC错误注入； 1'b1：打开ECC错误注入； </description>
                            <bitOffset>3</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>EFC_MAIN_ECC_EN</name>
                            <description> Main空间ECC功能使能开关； 0: ECC功能不使能； 1: ECC功能使能； Note：当使能注错功能时，对应注错地址需要先进行打开ecc使能后编程初始化，以确保注错地址本身存储的数据是ecc正确，否则上报的注错地址，不确定是其本身存储的数据ecc错误上报，还是注错导致的ecc错误地址上报；或者同时开启ECC读写翻转 </description>
                            <bitOffset>2</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>EFC_NVR_CFG_ECC_EN</name>
                            <description> NVR_CFG空间ECC功能使能开关； 0: ECC功能不使能； 1: ECC功能使能； Note：NVR_CFG空间必须奇偶ROW对应地址的数据一致，对应bit才能读出确定值。 </description>
                            <bitOffset>1</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>EFC_NVR_ECC_EN</name>
                            <description> NVR空间ECC功能使能开关； 0: ECC功能不使能； 1: ECC功能使能； </description>
                            <bitOffset>0</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                    </fields>
                </register>
                


                <register>
                    <name>EFC_RDN</name>
