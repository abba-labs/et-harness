                    <fields>
                        

                        <field>
                            <name>EFC_GFB_CTRLST_RPT</name>
                            <description> EFC_GFB模块CTRL状态，只读： 0：等待EFC GFB POWER&amp;RESET启动结束（WAITNG） 1：空闲（IDLE）； 2：写（WR）； 3：写RESP握手（WRESP）； 4：读（RD）； 5：擦除/VREAD RESP握手（BRESP）； </description>
                            <bitOffset>24</bitOffset>
                            <bitWidth>3</bitWidth>
                            <access>read-only</access>
                        </field>
                        

                        <field>
                            <name>EFC_GFB_ALLFCEST_RPT</name>
                            <description> EFC_GFB模块ALL FLASH CHIP ERASE（全片安全擦除）状态，只读： 0：空闲（IDLE）； 1：PFLASH MAIN+RDN全片擦除（PFMRCE）； 2：DFLASH MAIN+RDN全片擦除（DFMRCE）； other：DFLASH NVR Sector擦除（DFNVRSE）； </description>
                            <bitOffset>20</bitOffset>
                            <bitWidth>3</bitWidth>
                            <access>read-only</access>
                        </field>
                        

                        <field>
                            <name>EFC_GFB_CFGST_RPT</name>
                            <description> EFC_GFB模块CFG_PROC状态，只读: 0：空闲（IDLE）； 1：APB间接读（READ）； 2：APB间接写（WRITE）； 3：APB全片擦除（ALLFCE）； other：APB间接sector/block/chip擦除、Vread1检查（OTHER）。 </description>
                            <bitOffset>16</bitOffset>
                            <bitWidth>3</bitWidth>
                            <access>read-only</access>
                        </field>
                        

                        <field>
                            <name>EFC_GFB_RSTST_RPT</name>
                            <description> EFC_GFB模块RESET状态，只读： 0：空闲（IDLE）； 1：读NVR（RD NVR）； other：正常工作（WORKING）。 </description>
                            <bitOffset>12</bitOffset>
                            <bitWidth>2</bitWidth>
                            <access>read-only</access>
                        </field>
                        

                        <field>
                            <name>EFC_GFB_PWRST_RPT</name>
                            <description> EFC_GFB模块POWER上电状态，只读： 0：掉电（POWER OFF）； 1：读NVR_CFG（RD NVRC）； 2：写CFG寄存器（SETC）； 3：读CFG寄存器（RDC）；（车规FLASH MACRO新增操作） other：正常工作（WORKING）。 </description>
                            <bitOffset>8</bitOffset>
                            <bitWidth>3</bitWidth>
                            <access>read-only</access>
                        </field>
                        

                        <field>
                            <name>EFC_FCTRL_CTRLST_RPT</name>
                            <description> S40_FCTRL模块CTRL状态，只读： 0：空闲（IDLE）； 1：FLASH读（READ）； 2：FLASH写（WRITE）； 3：FLASH写CFG寄存器（SETCFG）； other：FLASH擦除（ERASE）。 </description>
                            <bitOffset>4</bitOffset>
                            <bitWidth>3</bitWidth>
                            <access>read-only</access>
                        </field>
                        

                        <field>
                            <name>EFC_FCTRL_PWRST_RPT</name>
                            <description> S40_FCTRL模块POWER状态，只读： 0：FLASH空闲（IDLE）； 1：FLASH上电（POWER ON）； 2：FLASH正常工作（WORKING）； other：FLASH深度睡眠（DPD Deep Power Down）。 </description>
                            <bitOffset>0</bitOffset>
                            <bitWidth>2</bitWidth>
                            <access>read-only</access>
                        </field>
                        

                    </fields>
                </register>
                


