                            <description> Transmission Completed 0= No transmission completed 1= Transmission completed </description>
                            <bitOffset>9</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

