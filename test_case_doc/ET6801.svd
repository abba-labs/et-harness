                            <bitOffset>8</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>RF1L</name>
                            <description> Rx FIFO 1 Message Lost 0= No Rx FIFO 1 message lost 1= Rx FIFO 1 message lost, also set after write attempt to Rx FIFO 1 of size zero </description>
                            <bitOffset>7</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>RF1F</name>
                            <description> Rx FIFO 1 Full 0= Rx FIFO 1 not full 1= Rx FIFO 1 full </description>
                            <bitOffset>6</bitOffset>
