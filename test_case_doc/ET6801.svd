                    <resetValue>0x03000007</resetValue>
                    <resetMask>0x133FFFFF</resetMask>
                    <fields>
                        

                        <field>
                            <name>EFC_NOECC_RSV_SEL</name>
                            <description> ECC功能使能关闭时，8bit8全1插入位置选择： 0:除RSV3bi外，最高8bit，即3bit RSV+8bit ECC+ 64bit DATA； 1:最低8bit，即3bit RSV+64bit DATA+8bit ECC； </description>
                            <bitOffset>28</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>EFC_ECC_RD_RVS</name>
                            <description> ECC读翻转开启使能； </description>
                            <bitOffset>25</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>EFC_ECC_WR_RVS</name>
                            <description> ECC写翻转开启使能； Note:ECC读写翻转功能需要同时使能和不使能，并且在开启ECC写入数据之后，必须首先擦除数据才能修改，在开启ECC读写翻转时，可对擦除后的地址直接读取并且不会触发ECC错误告警。 </description>
                            <bitOffset>24</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>EFC_ECC_ERRGEN_ADDR</name>
                            <description> ECC错误注入对应地址 </description>
                            <bitOffset>8</bitOffset>
                            <bitWidth>14</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>EFC_ECC_ERRGEN_SEC</name>
                            <description> 地址对应sector范围； 1: NVR； 3: Main； other：reserved </description>
                            <bitOffset>6</bitOffset>
                            <bitWidth>2</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
