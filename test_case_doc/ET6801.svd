                            <name>SL_LOCK_EN</name>
                            <description> 要求wdata[16]同时为1时，才能更新该参数 1表示使能SpinLock模块进入工作状态 0表示SpinLock模块退出工作状态 SpinLock模块不管是进入还是退出工作状态，不会对现有SPIN_LOCK上报的状态造成改变 </description>
                            <bitOffset>0</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
