                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>EFC_RDN0_EN</name>
                            <description> Redundancy sector的使能开关; 0: Redundancy sector使能关闭; 1: Redundancy sector使能打开； </description>
                            <bitOffset>12</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
