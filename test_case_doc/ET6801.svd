                            <bitOffset>6</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>SARC_FIFO_DMA_EN_2</name>
                            <description> DMA通道2是否选择fifo请求使能配置 'b 0：不选择fifo请求，通道2的请求由CFG_SARC_DMA_CTL控制； 'b 1：选择fifo请求，由cfg_sarc_fifo_dma_ch_2选择相应的fifo请求； </description>
                            <bitOffset>5</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>SARC_FIFO_DMA_CH_2</name>
                            <description> DMA通道2选择fifo请求时，选择信号配置。只有cfg_sarc_fifo_dma_en_2为1时，才能选择对应的fifo请求到DMA通道2。 'b 0：选择pre_fifo的请求； 'b 1：选择fil_fifo的请求； </description>
                            <bitOffset>4</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>SARC_FIFO_DMA_EN_1</name>
                            <description> DMA通道1是否选择fifo请求使能配置 'b 0：不选择fifo请求，通道1的请求由CFG_SARC_DMA_CTL控制； 'b 1：选择fifo请求，由cfg_sarc_fifo_dma_ch_1选择相应的fifo请求； </description>
                            <bitOffset>3</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

