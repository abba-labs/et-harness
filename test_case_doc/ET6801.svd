                            <bitOffset>11</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>EFC_APBS_EFCNWORK_BUSERR_EN</name>
                            <description> 配置总线错误产生使能； 0: 在EFC未工作时的后续操作，APB总线不反馈Error Resp； 1: 在EFC未工作时的后续操作，APB总线反馈Error Resp； </description>
                            <bitOffset>10</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>EFC_APBS_ECC2B_BUSERR_EN</name>
                            <description> 配置总线错误产生使能； 0: 在EFC未工作时的后续操作，APB总线不反馈Error Resp； 1: 在EFC未工作时的后续操作，APB总线反馈Error Resp； </description>
                            <bitOffset>9</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>EFC_APBS_WPT_BUSERR_EN</name>
                            <description> 配置总线错误产生使能； 0: 在发生wrp错误时，APB总线不反馈Error Resp； 1: 发生wrp错误时，APB总线反馈Error Resp； </description>
                            <bitOffset>8</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
