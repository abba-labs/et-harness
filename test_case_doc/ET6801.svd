                            <description>This is used to select DMA mode</description>
                            
                
                            <bitOffset>3</bitOffset>
                            
                
                            <bitWidth>1</bitWidth>
                            
                
                            <access>write</access>
                            
                
                            <modifiedWriteValues/>
                            
            
                        </field>
                        
            
                        <field>
                            
                
                            <name>XFIFOR</name>
                            
                
                            <description>This resets the control portion of the transmit FIFO and treats the FIFO as empty. This will also de-assert the DMA TX request and single signals when additional DMA handshaking signals are selected.</description>
                            
                
                            <bitOffset>2</bitOffset>
                            
                
                            <bitWidth>1</bitWidth>
                            
                
