                    <access>
                        read-write
                    </access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0xFFFFFFFF</resetMask>
                    <fields>
                        

                        <field>
                            <name>SARC_FILTER_TYPE</name>
                            <description> 8个滤波通道类型选择，每个通道2bit表示类型选择。bit17-bit16指示滤波通道0的类型，...bit31-bit30指示滤波通道7的类型。 'b 00：FIR； 'b 01：IIR； 'b 10：非滑动平均； 'b 11：无效； </description>
                            <bitOffset>16</bitOffset>
                            <bitWidth>16</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>SARC_FILTER_STATE_CLR</name>
                            <description> 软件写1清除对应滤波通道状态，软件写0无效。bit15-bit8分别对应滤波通道7-滤波通道0。 建议在开启一轮新的滤波功能前，使用该控制位对滤波器进行清除，防止滤波历史残留数据对新数据的滤波产生影响。 </description>
                            <bitOffset>8</bitOffset>
                            <bitWidth>8</bitWidth>
                            <access>write-only</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>SARC_FILTER_EN</name>
                            <description> 8个滤波通道使能信号，bit0-bit7分别指示滤波通道0-7。 'b 0：不使能； 'b 1：使能； </description>
                            <bitOffset>0</bitOffset>
                            <bitWidth>8</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                    </fields>
                </register>
                


