                            <description> OR of the contents of StatusDstTranValues: 0x0 (INACTIVE): OR of the contents of StatusDstTran register is 00x1 (ACTIVE): OR of the contents of StatusDstTran register is 1 </description>
                            <bitOffset>3</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-only</access>
                        </field>
                        

                        <field>
                            <name>SRCT</name>
                            <description> OR of the contents of StatusSrcTranValues: 0x0 (INACTIVE): OR of the contents of StatusSrcTran register is 00x1 (ACTIVE): OR of the contents of StatusSrcTran register is 1 </description>
                            <bitOffset>2</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-only</access>
                        </field>
                        

                        <field>
                            <name>BLOCK</name>
                            <description> OR of the contents of StatusBlock registerValues: 0x0 (INACTIVE): OR of the contents of StatusBlock register is 00x1 (ACTIVE): OR of the contents of StatusBlock register is 1 </description>
                            <bitOffset>1</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-only</access>
                        </field>
                        

                        <field>
                            <name>TFR</name>
                            <description> OR of the contents of StatusTfr registerValues: 0x0 (INACTIVE): OR of the contents of StatusTfr register is 00x1 (ACTIVE): OR of the contents of StatusTfr register is 1 </description>
                            <bitOffset>0</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-only</access>
                        </field>
                        

                    </fields>
