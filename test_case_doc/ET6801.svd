                            <description> Returns the byte lane strobe operating mode for an SRAM memory interface:0 = bls timing equals chip select timing. This is the default setting.1 = bls timing equals we_n timing.For a NAND memory interface this bit is reserved. </description>
                            <bitOffset>12</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-only</access>
                        </field>
                        

                        <field>
                            <name>adv_intf1</name>
                            <description> Returns the address advance signal operating mode for an SRAM memory interface:0 = SMC ties adv_n HIGH. This is the default setting.1 = SMC sets adv_n LOW at the start of a transfer.For a NAND memory interface this bit is reserved. </description>
                            <bitOffset>11</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-only</access>
                        </field>
                        

                        <field>
                            <name>baa_intf1</name>
                            <description> Returns the burst address advance signal operating mode for an SRAM memory interface:0 = SMC ties baa_n HIGH. This is the default setting.1 = SMC sets baa_n LOW.For a NAND memory interface this bit is reserved. </description>
                            <bitOffset>10</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-only</access>
                        </field>
                        

                        <field>
                            <name>wr_bl_intf1</name>
                            <description> Returns the memory burst length for writes on an SRAM memory interface:b000 = 1 beat. This is the default setting.b001 = 4 beatsb010 = 8 beatsb011 = 16 beatsb100 = 32 beatsb101 = continuousb110-b111 = reserved.For a NAND memory interface these bits are reserved. </description>
                            <bitOffset>7</bitOffset>
                            <bitWidth>3</bitWidth>
                            <access>read-only</access>
                        </field>
                        

                        <field>
                            <name>wr_sync_intf1</name>
                            <description> Returns the write operating mode for an SRAM memory interface:0 = SMC performs asynchronous writes. This is the default setting.1 = SMC performs synchronous writes.For a NAND memory interface this bit is reserved. </description>
                            <bitOffset>6</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-only</access>
                        </field>
                        

                        <field>
                            <name>rd_bl_intf1</name>
                            <description> Returns the memory burst length for reads on an SRAM memory interface:b000 = 1 beat. This is the default setting.b001 = 4 beatsb010 = 8 beatsb011 = 16 beatsb100 = 32 beatsb101 = continuousb110-b111 = reserved.For a NAND memory interface these bits are reserved. </description>
                            <bitOffset>3</bitOffset>
                            <bitWidth>3</bitWidth>
                            <access>read-only</access>
                        </field>
                        

                        <field>
                            <name>rd_sync_intf1</name>
                            <description> Returns the read operating mode for an SRAM memory interface:0 = SMC performs asynchronous reads. This is the default setting.1 = SMC performs synchronous reads.For a NAND memory interface this bit is reserved. </description>
                            <bitOffset>2</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-only</access>
                        </field>
                        

                        <field>
                            <name>mw_intf1</name>
                            <description> Returns the SMC memory data bus width:b00 = 8 bitsb01 = 16 bitsb10 = 32 bitsb11 = reserved.You can use the sram_mw__intf1[1:0] or nand_mw__intf1 tie-offs to set the memory width for chip select 0, memory interface _intf1, to enable booting from that chip. The reset value of memory width for all other chip selects is the configured width. </description>
                            <bitOffset>0</bitOffset>
                            <bitWidth>2</bitWidth>
                            <access>read-only</access>
                        </field>
                        

                    </fields>
                </register>
                 


                <register>
                    <name>user_status</name>
                    <description>Describe the details of the register: user_status</description>
                    <addressOffset>0x0200</addressOffset>
                    <size>32</size>
                    <access>
                        read-only
                    </access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0xFF000000</resetMask>
                    <fields>
                        

                        <field>
                            <name>user_status</name>
                            <description> This value returns the state of the user_status[7:0] inputs </description>
                            <bitOffset>0</bitOffset>
                            <bitWidth>8</bitWidth>
                            <access>read-only</access>
                        </field>
                        

                    </fields>
                </register>
                 


                <register>
                    <name>user_config</name>
                    <description>Describe the details of the register: user_config</description>
                    <addressOffset>0x0204</addressOffset>
                    <size>32</size>
                    <access>
                        read-write 
                    </access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0xFF000000</resetMask>
                    <fields>
                        

                        <field>
                            <name>user_config</name>
                            <description> This value sets the state of the user_config[7:0] outputs </description>
                            <bitOffset>0</bitOffset>
                            <bitWidth>8</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                    </fields>
                </register>
                 


                <register>
                    <name>ecc_intf0_status</name>
                    <description>Describe the details of the register: ecc_intf0_status</description>
                    <addressOffset>0x0300</addressOffset>
                    <size>32</size>
                    <access>
                        read-write 
                    </access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0xFFFFFFFC</resetMask>
                    <fields>
                        

                        <field>
                            <name>ecc_read</name>
                            <description> Read flags for ECC blocks. Indicates whether the stored ECC value for each block has been read from memory0 = not read1 = read. </description>
                            <bitOffset>25</bitOffset>
                            <bitWidth>5</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>ecc_can_correct</name>
                            <description> Correctable flag for each ECC block. Indicates if the detected error is correctablea:0 = not correctable1 = correctable.See Table 2-33 on SMC databook page 2-48 for the decoding information of the ecc_can_correct flag and ecc_fail flag. </description>
                            <bitOffset>20</bitOffset>
                            <bitWidth>5</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>ecc_fail</name>
                            <description> Pass, fail flag for each ECC block:0 = pass1 = fail.See Table 2-33 on SMC databook page 2-48 for the decoding information of the ecc_can_correct flag and ecc_fail flag. </description>
                            <bitOffset>15</bitOffset>
                            <bitWidth>5</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>ecc_value_valid</name>
                            <description> Valid flag for each ECC block. </description>
                            <bitOffset>10</bitOffset>
                            <bitWidth>5</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>ecc_rd_n_wr</name>
                            <description> 0 = write1 = read. </description>
                            <bitOffset>9</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>ecc_last_status</name>
                            <description> b00 = Completed successfullyb01 = Unaligned address, or out-of-rangeb10 = Data stop after incomplete blockb11 = Data stopped but values not read/written because of ecc_jump value.Note The ecc_last_status bit is only updated at the completion of an ECC calculation. </description>
                            <bitOffset>7</bitOffset>
                            <bitWidth>2</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>ecc_status</name>
                            <description> Provides the status of the ECC block:0 = idle1 = busy. </description>
                            <bitOffset>6</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>ecc_int_status</name>
                            <description> The interrupts are:【5】Abort.【4】Extra block (if used).【3】Block 3.【2】Block 2.【1】Block 1.【0】Block 0.NoteTo clear an interrupt, write a 1 to the appropriate bit. </description>
                            <bitOffset>0</bitOffset>
                            <bitWidth>6</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                    </fields>
                </register>
                 


                <register>
                    <name>ecc_intf0_cfg</name>
                    <description>Describe the details of the register: ecc_intf0_cfg</description>
                    <addressOffset>0x0304</addressOffset>
                    <size>32</size>
                    <access>
                        read-write 
                    </access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0xFFF80000</resetMask>
                    <fields>
                        

                        <field>
                            <name>ecc_extra_block_size</name>
                            <description> The size of the extra block in memory after the last 512-byte block:b00 = 4 bytesb01 = 8 bytesb10 = 16 bytesb11 = 32 bytes.Note These bits are only present if you configure the SMC to use the ECC Extra Block Enable option. See the CoreLink SMC-35x AXI Static Memory Controller Series Supplement to AMBA Designer (FD001) User Guide for information about enabling this option. </description>
                            <bitOffset>11</bitOffset>
                            <bitWidth>2</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>ecc_extra_block</name>
                            <description> If configured, this enables a small block for extra information after the last 512 bytes block in the page.Note These bits are only present if the ECC Extra Block Enable option is configured. </description>
                            <bitOffset>10</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>ecc_int_abort</name>
                            <description> Interrupt on ECC abort. </description>
                            <bitOffset>9</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>ecc_int_pass</name>
                            <description> Interrupt when a correct ECC value is read from memory. </description>
                            <bitOffset>8</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>ecc_ignore_add_eight</name>
                            <description> This bit is used to indicate if A8 is output with the address, required to find the aligned start of blocks:0 = A8 is output1 = A8 is not output.See Secondary mode addressing on SMC databook page 2-45. </description>
                            <bitOffset>7</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>ecc_jump</name>
                            <description> Indicates that the memory supports column change address commands:b00 = no jumping, reads and writes only occur at end of pageb01 = jump using column change commandsb10 = jump using full commandb11 = reserved. </description>
                            <bitOffset>5</bitOffset>
                            <bitWidth>2</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>ecc_read_end</name>
                            <description> Indicates when ECC values are read from memory:0 = the ECC value for a block must be read immediately after the block. Data access must stop on a 512 byte boundary.1 = ECC values for all blocks are read at the end of the page. </description>
                            <bitOffset>4</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>ecc_mode</name>
                            <description> This specifies the mode of the ECC block:b00 = bypassed.b01 = ECC values are calculated and made available on the APB interface, but they are not read from or written to memory.b10 = ECC values and calculated and read/written to memory. For a read, the ECC value is checked and the result of the check is made available on the APB interface.b11 = reserved. </description>
                            <bitOffset>2</bitOffset>
                            <bitWidth>2</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>page_size</name>
                            <description> The number of 512 byte blocks in a page:b00 = No 512 byte blocks. Reserved if an ecc_extra_block is not configured, or if an ecc_extra_block is configured but is not enabled.b01 = One 512 byte block.b10 = Two 512 byte blocks.b11 = Four 512 byte blocks. </description>
                            <bitOffset>0</bitOffset>
                            <bitWidth>2</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                    </fields>
                </register>
                 


