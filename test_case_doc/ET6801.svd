                    <description>TB_SYNC</description>
                    <addressOffset>0x0028</addressOffset>
                    <size>32</size>
                    <access>
                        read-write
                    </access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0x00007F7F</resetMask>
                    <fields>
                        

                        <field>
                            <name>TB_SYNC1_MSEL</name>
                            <description> timer_base 同步信号1选择，从时基计数器同步事件集合中选择，采用Mask_OR方式 </description>
                            <bitOffset>8</bitOffset>
                            <bitWidth>7</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>TB_SYNC0_MSEL</name>
                            <description> timer_base 同步信号0选择，从时基计数器同步事件集合中选择，采用Mask_OR方式。 </description>
                            <bitOffset>0</bitOffset>
                            <bitWidth>7</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
