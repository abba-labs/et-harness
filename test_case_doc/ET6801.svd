<?xml version="1.0" ?>
<device schemaVersion="1.1">
    

    <vendor>ETMCU Inc.</vendor>
    

    <vendorID>ETMCU</vendorID>
    <name>ET6801</name>
    <version>v0.0.1</version>
    <description>ET6801 ARM 32-bit Cortex-M7 Microcontroller based device</description>
    <addressUnitBits>8</addressUnitBits>
    <width>32</width>
    <peripherals>
        


        <peripheral>
            

            <name>SRPWMCOM</name>
            

            <version>gen_svd_from_excel.py v1.0</version>
            <description>Provide an overview of the purpose and functionality of the peripheral: epwmcom_cfg</description>
            <baseAddress>0x40000000</baseAddress>
            <addressBlock>
                <offset>0</offset>
                <size>0x1000</size>
                <usage>registers</usage>
            </addressBlock>
            <registers>
                


                <register>
                    <name>EPWMCOM_HEAD</name>
                    <description>EPWMCOM_HEAD</description>
                    <addressOffset>0x0000</addressOffset>
                    <size>32</size>
                    <access>
                        read-write
                    </access>
                    <resetValue>0x4D774D77</resetValue>
                    <resetMask>0xFFFFFFFF</resetMask>
                    <fields>
                        

                        <field>
                            <name>HEAD_SW_WR</name>
                            <description> 软件测试读写寄存器，硬件无访问 </description>
                            <bitOffset>16</bitOffset>
                            <bitWidth>16</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>HEAD_SW_RO</name>
                            <description> 软件只读上报寄存器，硬件无访问,XXX的ASICII 码表示 </description>
                            <bitOffset>0</bitOffset>
                            <bitWidth>16</bitWidth>
                            <access>read-only</access>
                        </field>
                        

                    </fields>
                </register>
                


                <register>
                    <name>EPWM_EN</name>
                    <description>EPWM_EN</description>
                    <addressOffset>0x0010</addressOffset>
                    <size>32</size>
                    <access>
                        read-write
                    </access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0x0003FFFF</resetMask>
                    <fields>
                        

                        <field>
                            <name>EPWM_EN</name>
                            <description> EPWM模块使能信号，每个EPWM模块对应1bit；bit0~bit11分别对应EPWM0~18； 0：不使能； 1：使能。 </description>
                            <bitOffset>0</bitOffset>
                            <bitWidth>18</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                    </fields>
                </register>
                


                <register>
                    <name>EPWM_HR_EN</name>
                    <description>EPWM_HR_EN</description>
                    <addressOffset>0x0014</addressOffset>
                    <size>32</size>
                    <access>
                        read-write
                    </access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0x0013FFFF</resetMask>
                    <fields>
                        

                        <field>
                            <name>ULTRA_HRPWM_EN</name>
                            <description> 超高精度PWM模式使能。 'b0：支持分辨率为156.25ps的高精度PWM 'b1：支持分辨率为78.125ps的超高精度PWM </description>
                            <bitOffset>20</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>EPWM_HR_EN</name>
                            <description> EPWM模块高精度发波使能信号，每个EPWM模块对应1bit；bit0~bit11分别对应EPWM0~11； 0：不使能； 1：使能。 </description>
                            <bitOffset>0</bitOffset>
                            <bitWidth>18</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                    </fields>
                </register>
                


                <register>
                    <name>SHD_MULTICFG_UPT</name>
                    <description>SHD_MULTICFG_UPT</description>
                    <addressOffset>0x0020</addressOffset>
                    <size>32</size>
                    <access>
                        read-write
                    </access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0x0003FFFF</resetMask>
                    <fields>
                        

                        <field>
                            <name>SHD_MULTICFG_UPT</name>
                            <description> 多个EPWM模块配置寄存器同步更新，写1产生脉冲进行更新；每一bit对应一个epwm模块，bit0~bit18分别对应EPWM0~18； </description>
                            <bitOffset>0</bitOffset>
                            <bitWidth>18</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                    </fields>
                </register>
                


                <register>
                    <name>MULTCFG_MOD</name>
                    <description>MULTCFG_MOD</description>
                    <addressOffset>0x0024</addressOffset>
                    <size>32</size>
                    <access>
                        read-write
                    </access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0x00000011</resetMask>
                    <fields>
                        

                        <field>
                            <name>HW_CONFLT_ADAPT_MASK</name>
                            <description> b0：做同步加载的冲突规避 'b1：不做同步加载的冲突规避 </description>
                            <bitOffset>4</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>MULTCFG_MD</name>
                            <description> 同步加载冲突规避模式选择寄存器 1'b0：发生冲突时配置寄存器优先，在软件对参与通道间同步加载的寄存器写配置参数期间，不产生影子加载事件更新活跃值的动作，直至软件完成相关寄存器配置并对寄存器CFG_SHD_MULTICFG_UPT进行写操作后才恢复对影子事件的等待和响应； 1'b1：发生冲突时影子加载事件优先，在影子事件出现之前的一定时间范围内（用户配置时间范围长度），软件写下来的配置不会写到寄存器中。 </description>
                            <bitOffset>0</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                    </fields>
                </register>
                


                <register>
                    <name>MULTCFG_FB_ZONE</name>
                    <description>MULTCFG_FB_ZONE</description>
                    <addressOffset>0x0028</addressOffset>
                    <size>32</size>
                    <access>
                        read-write
                    </access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0x00003FFF</resetMask>
                    <fields>
                        

                        <field>
                            <name>MULTCFG_FB_ZONE</name>
                            <description> 同步加载参数禁止写入区间寄存器，用于指定影子事件出现之前不对（参与通道间同步加载的）寄存器进行更新的时间范围，以SRPWM模块的工作时钟周期为单位，当工作时钟为200MHz时，最大值对应82us左右时间。需注意此寄存器的配置值应小于通道内寄存器CFG_TB_PRD[cfg_tb_prd[28:7]]的配置值。此寄存器配置值仅在CFG_MULT_CFG_MD='b1时才有意义。 </description>
                            <bitOffset>0</bitOffset>
                            <bitWidth>14</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                    </fields>
                </register>
                


                <register>
                    <name>MULTCFG_CONFLICT_RPT</name>
                    <description>MULTCFG_CONFLICT_RPT</description>
                    <addressOffset>0x002C</addressOffset>
                    <size>32</size>
                    <access>
                        read-only
                    </access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0x0003FFFF</resetMask>
                    <fields>
                        

                        <field>
                            <name>MULTCFG_CONFLICT_RPT</name>
                            <description> 上报同步加载期间的冲突事件。每个比特对应一个PWM通道，LSB对应PWM0通道，MSB对应PWM17通道，高电平表示出现过冲突，置高电平后保持，需要软件通过对寄存器cfg_multcfg_conflict_rpt_clr对应比特写1清除。 当CFG_ MULT_CFG_MD配置为'b0，在某个通道内，从出现第一个同步加载参数的写使能到同步加载指令脉冲（寄存器CFG_SHD_MULTICFG_UPT写1产生的脉冲）出现之前的时间段内如果出现该通道的同步加载影子事件（此时间段内出现的影子事件实际未起作用，未进行活跃值更新），则该通道对应的multcfg_conflict_rpt寄存器比特将被置1。 当CFG_ MULT_CFG_MD配置为'b1，在某个通道内，影子事件出现前的禁止写寄存器时间段内（由寄存器CFG_MULT_CFG_FB_ZONE指定），如果发生软件对同步加载相关寄存器的写操作，则该通道对应的multcfg_conflict_rpt寄存器比特将被置1。 </description>
                            <bitOffset>0</bitOffset>
                            <bitWidth>18</bitWidth>
                            <access>read-only</access>
                        </field>
                        

                    </fields>
                </register>
                


                <register>
                    <name>AQ_OTSFT_GRPA</name>
                    <description>AQ_OTSFT_GRPA</description>
                    <addressOffset>0x0030</addressOffset>
                    <size>32</size>
                    <access>
                        read-write
                    </access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0xFFFFFFFF</resetMask>
                    <fields>
                        

                        <field>
                            <name>AQ_OTSFT_0_15B</name>
                            <description> epwmb信号软件触发一次(one time)强制动作，写1产生脉冲。 bit0~bit11分别对应EPWM0~15； 此寄存器是写自清零寄存器，软件写一次1产生一个脉冲，软件配置1后，对应通道的AQ逻辑响应此脉冲，等到寄存器cfg_aq_sftstart_sync_mselb选定的start事件有效，会执行动作（动作内容由AQ寄存器cfg_aq_ctl_sftb决定），然后等AQ寄存器cfg_aq_sftend_sync_mselb选定的end事件有效，该次软件强制动作结束。由于软件写一次只产生一个脉冲，因此动作持续的时间是从 start事件到end事件的间隔时间。软件配置动作的优先级高于AQ矩阵的其余22个事件。 </description>
                            <bitOffset>16</bitOffset>
                            <bitWidth>16</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>AQ_OTSFT_0_15A</name>
                            <description> epwma信号软件触发一次(one time)强制动作，写1产生脉冲。 bit0~bit11分别对应EPWM0~15； 此寄存器是写自清零寄存器，软件写一次1产生一个脉冲，软件配置1后，对应通道的AQ逻辑响应此脉冲，等到寄存器cfg_aq_sftstart_sync_msela选定的start事件有效，会执行动作（动作内容由AQ寄存器cfg_aq_ctl_sfta决定），然后等AQ寄存器cfg_aq_sftend_sync_msela选定的end事件有效，该次软件强制动作结束。由于软件写一次只产生一个脉冲，因此动作持续的时间是从 start事件到end事件的间隔时间。软件配置动作的优先级高于AQ矩阵的其余22个事件。 </description>
                            <bitOffset>0</bitOffset>
                            <bitWidth>16</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                    </fields>
                </register>
                


                <register>
                    <name>AQ_OTSFT_GRPB</name>
                    <description>AQ_OTSFT_GRPB</description>
                    <addressOffset>0x0034</addressOffset>
                    <size>32</size>
                    <access>
                        read-write
                    </access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0x00000033</resetMask>
                    <fields>
                        

                        <field>
                            <name>AQ_OTSFT_16_17B</name>
                            <description> epwmb信号软件触发一次(one time)强制动作，写1产生脉冲。 bit0~bit1分别对应EPWM16~17； 此寄存器是写自清零寄存器，软件写一次1产生一个脉冲，软件配置1后，对应通道的AQ逻辑响应此脉冲，等到寄存器cfg_aq_sftstart_sync_mselb选定的start事件有效，会执行动作（动作内容由AQ寄存器cfg_aq_ctl_sftb决定），然后等AQ寄存器cfg_aq_sftend_sync_mselb选定的end事件有效，该次软件强制动作结束。由于软件写一次只产生一个脉冲，因此动作持续的时间是从 start事件到end事件的间隔时间。软件配置动作的优先级高于AQ矩阵的其余22个事件。 </description>
                            <bitOffset>4</bitOffset>
                            <bitWidth>2</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>AQ_OTSFT_16_17A</name>
                            <description> epwma信号软件触发一次(one time)强制动作，写1产生脉冲。 bit0~bit1分别对应EPWM16~17； 此寄存器是写自清零寄存器，软件写一次1产生一个脉冲，软件配置1后，对应通道的AQ逻辑响应此脉冲，等到寄存器cfg_aq_sftstart_sync_msela选定的start事件有效，会执行动作（动作内容由AQ寄存器cfg_aq_ctl_sfta决定），然后等AQ寄存器cfg_aq_sftend_sync_msela选定的end事件有效，该次软件强制动作结束。由于软件写一次只产生一个脉冲，因此动作持续的时间是从 start事件到end事件的间隔时间。软件配置动作的优先级高于AQ矩阵的其余22个事件。 </description>
                            <bitOffset>0</bitOffset>
                            <bitWidth>2</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                    </fields>
                </register>
                


                <register>
                    <name>AQ_CSFT_GRPA</name>
                    <description>AQ_CSFT_GRPA</description>
                    <addressOffset>0x0038</addressOffset>
                    <size>32</size>
                    <access>
                        read-write
                    </access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0xFFFFFFFF</resetMask>
                    <fields>
                        

                        <field>
                            <name>AQ_CSFT_0_15B</name>
                            <description> epwmb信号软件持续(continuous)强制动作。配置为1生效，配置0退出。 bit0~bit15分别对应EPWM0~15； 与cfg_aq_otsftb寄存器不同，此寄存器是写1后持续保持高电平，软件配置1后，根据AQ寄存器cfg_aq_sftstart_mdb的配置值不同，会立即产生动作或者是等到寄存器cfg_aq_sftstart_sync_mselb选定的start事件有效再执行动作（动作内容由AQ寄存器cfg_aq_ctl_sftb决定），当前寄存器从置1变为置0后，根据AQ寄存器cfg_aq_sftend_mdb的配置值不同，动作立即结束或等AQ寄存器cfg_aq_sftend_sync_mselb选定的end事件有效，该次软件强制动作结束。软件配置动作的优先级高于AQ矩阵的其余22个事件。 </description>
                            <bitOffset>16</bitOffset>
                            <bitWidth>16</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>AQ_CSFT_0_15A</name>
                            <description> epwma信号软件持续(continuous)强制动作。配置为1生效，配置0退出。 bit0~bit15分别对应EPWM0~15； 与cfg_aq_otsfta寄存器不同，此寄存器是写1后持续保持高电平，软件配置1后，根据AQ寄存器cfg_aq_sftstart_mda的配置值不同，会立即产生动作或者是等到寄存器cfg_aq_sftstart_sync_msela选定的start事件有效再执行动作（动作内容由AQ寄存器cfg_aq_ctl_sfta决定），当前寄存器从置1变为置0后，根据AQ寄存器cfg_aq_sftend_mda的配置值不同，动作立即结束或等AQ寄存器cfg_aq_sftend_sync_msela选定的end事件有效，该次软件强制动作结束。软件配置动作的优先级高于AQ矩阵的其余22个事件。 </description>
                            <bitOffset>0</bitOffset>
                            <bitWidth>16</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
