                            <bitOffset>1</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>SARC_READY_PROC_MOD</name>
                            <description> ADC READY处理模式选择配置（数字侧）。 'b 0：异步处理； 'b 1：同步处理。 </description>
                            <bitOffset>0</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                    </fields>
                </register>
                


                <register>
                    <name>EOC_CTL</name>
                    <description>EOC_CTL</description>
                    <addressOffset>0x001C</addressOffset>
                    <size>32</size>
                    <access>
                        read-write
                    </access>
                    <resetValue>0x00020000</resetValue>
                    <resetMask>0xFF07FFFF</resetMask>
                    <fields>
                        

                        <field>
                            <name>EOC2SPL_TRIG0_SEL</name>
                            <description> EOC事件输出1选择配置，从16个虚拟通道的EOC事件中选择1个作为ADC的采样触发源。 'd0：虚拟通道0的EOC事件； 'd1：虚拟通道1的EOC事件； ...... 'd15：虚拟通道15的EOC事件； </description>
                            <bitOffset>28</bitOffset>
                            <bitWidth>4</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>EOC2SPL_TRIG1_SEL</name>
                            <description> EOC事件输出2选择配置，从16个虚拟通道的EOC事件中选择1个作为ADC的采样触发源。 'd0：虚拟通道0的EOC事件； 'd1：虚拟通道1的EOC事件； ...... 'd15：虚拟通道15的EOC事件； </description>
                            <bitOffset>24</bitOffset>
                            <bitWidth>4</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>EOC_MOD</name>
                            <description> EOC产生时刻选择： 'b00：选择采样结束时刻，S/H窗口下降沿； 'b01：选择转换结束时刻，模拟ADC返回ready上升沿； 'b10: 选择采样开始时刻，S/H窗口上升沿,（内部状态仲裁出通道号后即给出，实际会比START信号早一点）； 'b11: reserved，同'b01； </description>
                            <bitOffset>17</bitOffset>
                            <bitWidth>2</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>EOC_DLY_EN</name>
                            <description> EOC选择时刻到中断上升沿是否延时的使能配置。 'b0：不使能延时，EOC时刻直接产生中断； 'b1：使能延时，在EOC时刻延时cfg_eoc_dly的SYSCLK周期后产生中断； </description>
                            <bitOffset>16</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>EOC_DLY</name>
                            <description> EOC选择时刻到中断上升沿的延时值配置，SYSCLK周期数。 实际延时值为该配置值加1，即cfg_eoc_dly+1。 </description>
                            <bitOffset>0</bitOffset>
                            <bitWidth>16</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                    </fields>
                </register>
                


                <register>
                    <name>EOC_STS</name>
                    <description>EOC_STS</description>
                    <addressOffset>0x0020</addressOffset>
                    <size>32</size>
                    <access>
                        read-only
                    </access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0x0000001F</resetMask>
                    <fields>
                        

                        <field>
                            <name>EOC_ALM_FLAG</name>
                            <description> 当eoc事件到达时，延时处理模块如果处于busy状态，则上报告警。 'b 0：无告警产生； 'b 1：有延时处理冲突告警； </description>
                            <bitOffset>4</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-only</access>
                            <readAction> clear </readAction>
                        </field>
                        

                        <field>
                            <name>EOC_ALM_VCNUM</name>
                            <description> 当eoc_alm_flag为高时，该域表示产生延时处理冲突的虚拟通道编号。 当eoc_alm_flag为低时，该域无效。 'd0~'d15对应表示虚拟通道0~15。 </description>
                            <bitOffset>0</bitOffset>
                            <bitWidth>4</bitWidth>
                            <access>read-only</access>
                        </field>
                        

                    </fields>
                </register>
                


                <register>
                    <name>ADC_STATUS</name>
                    <description>ADC_STATUS</description>
                    <addressOffset>0x0024</addressOffset>
                    <size>32</size>
                    <access>
                        read-only
                    </access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0x0000001F</resetMask>
                    <fields>
                        

                        <field>
                            <name>SARC_ADC_BUSY</name>
                            <description> ADC采样busy状态。 ADC VC采样转换开始时置1，即busy； 虚拟通道VC采样转换完成后置0，即idle； 'b 0：IDLE； 'b 1：BUSY； </description>
                            <bitOffset>4</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-only</access>
                        </field>
                        

                        <field>
                            <name>SARC_ADC_BUSY_CH</name>
                            <description> ADC busy通道指示。 adc_busy =0：保持上一个转换的VC通道号； adc_busy=1：指示当前正在转换操作的VC通道号； </description>
                            <bitOffset>0</bitOffset>
                            <bitWidth>4</bitWidth>
                            <access>read-only</access>
                        </field>
                        

                    </fields>
                </register>
                


                <register>
                    <name>BLK_CTL0</name>
                    <description>BLK_CTL0</description>
                    <addressOffset>0x0028</addressOffset>
                    <size>32</size>
                    <access>
                        read-write
                    </access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0x0000007F</resetMask>
                    <fields>
                        

                        <field>
                            <name>SARC_BLANKING_EN</name>
                            <description> ADC控制器的blanking功能使能标志。每个ADC控制器只有虚拟通道0（VC0）支持blanking管理功能。 'b 0：不使能； 'b 1：使能； </description>
                            <bitOffset>6</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>SARC_BLANKING_TRIG</name>
                            <description> ADC控制器的blanking触发源选择，该触发源触发blanking事件产生。Blanking支持64个触发源： </description>
                            <bitOffset>0</bitOffset>
                            <bitWidth>6</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                    </fields>
                </register>
                


                <register>
                    <name>BLK_CTL1</name>
                    <description>BLK_CTL1</description>
                    <addressOffset>0x002C</addressOffset>
                    <size>32</size>
                    <access>
                        read-write
                    </access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0xFFFFFFFF</resetMask>
                    <fields>
                        

                        <field>
                            <name>SARC_BLANKING_TRIG_DELAY</name>
                            <description> ADC控制器的blanking延迟触发时间配置。SYSCLK时钟16bit计数器。配置值即为时钟周期数。 注意：在使能blanking功能时，该配置值需要大于0； </description>
                            <bitOffset>16</bitOffset>
                            <bitWidth>16</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>SARC_BLANKING_LEN</name>
                            <description> ADC控制器的blanking窗口长度配置。SYSCLK时钟16bit计数器。配置值即为时钟周期数。 注意： 1、在使能blanking功能时，该配置值需要大于0； 2、延迟时间和窗口长度配置时，需考虑将窗口提前打开，提前时间为一次转换时间。 </description>
                            <bitOffset>0</bitOffset>
                            <bitWidth>16</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                    </fields>
                </register>
                


                <register>
                    <name>VCEN_CTL</name>
                    <description>VCEN_CTL</description>
                    <addressOffset>0x0030</addressOffset>
                    <size>32</size>
                    <access>
                        read-write
                    </access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0x0000FFFF</resetMask>
                    <fields>
                        

                        <field>
                            <name>SARC_VC_EN</name>
                            <description> VC的使能信号,16bit分别表示16个VC的使能配置： 'b 0：不使能该VC； 'b 1：使能该VC； </description>
                            <bitOffset>0</bitOffset>
                            <bitWidth>16</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                    </fields>
                </register>
                


                <cluster>
                    <dim>16</dim>
                    <dimIncrement>0x0004</dimIncrement>
                    <name>VC_CTL[%s]</name>
                    <description>CFG_SARC_VC_CTL</description>
                    <addressOffset>0x0034</addressOffset>
                    


                    <register>
                        <name>VC_CTL</name>
                        <description>VC_CTL</description>
                        <addressOffset>0x0</addressOffset>
                        <size>32</size>
                        <access>
                        read-write
                    </access>
                        <resetValue>0x00000000</resetValue>
                        <resetMask>0x7FFFF9FF</resetMask>
                        <fields>
                            

                            <field>
                                <name>SARC_VC_CH_TYPE</name>
                                <description> VC采样通道类型选择： 0：单端模式； 1：差分模式； </description>
                                <bitOffset>30</bitOffset>
                                <bitWidth>1</bitWidth>
                                <access>read-write</access>
                                <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                            </field>
                            

                            <field>
                                <name>SARC_VC_PRIORITY</name>
                                <description> VC的优先级指示。值越小优先级越高，同一优先级组中，VC的序号越小优先级越高。 'b 00：该VC处理第一优先级组； 'b 01：该VC处理第二优先级组； 'b 10：该VC处理第三优先级组； 'b 11：该VC处理第四优先级组； </description>
                                <bitOffset>28</bitOffset>
                                <bitWidth>2</bitWidth>
                                <access>read-write</access>
                                <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                            </field>
                            

                            <field>
                                <name>SARC_VC_FILTER_EN</name>
                                <description> VC通道是否滤波。 'b 0：不滤波 'b 1：滤波 </description>
                                <bitOffset>27</bitOffset>
                                <bitWidth>1</bitWidth>
                                <access>read-write</access>
                                <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                            </field>
                            

                            <field>
                                <name>SARC_VC_FILTER_CH</name>
                                <description> VC通道与滤波通道的映射关系。 'b 000：映射滤波通道0； 'b 001：映射滤波通道1； ...... 'b 111：映射滤波通道7。 </description>
                                <bitOffset>24</bitOffset>
                                <bitWidth>3</bitWidth>
                                <access>read-write</access>
                                <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                            </field>
                            

                            <field>
                                <name>SARC_VC_TRIG_MODE</name>
                                <description> VCx的触发模式选择。支持One-Shot和Continuous两种触发模式。 'b 0：Continuous模式； 'b 1：One-Shot模式； </description>
                                <bitOffset>23</bitOffset>
                                <bitWidth>1</bitWidth>
                                <access>read-write</access>
                                <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                            </field>
                            

                            <field>
                                <name>SARC_VC_TRIG_SEL</name>
                                <description> VCx的触发源选择。支持128个触发源选择。 </description>
                                <bitOffset>16</bitOffset>
                                <bitWidth>7</bitWidth>
                                <access>read-write</access>
                                <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                            </field>
                            

                            <field>
                                <name>SARC_VC_SE_MUX</name>
                                <description> VCx的单端转换通道选择。 'd0：通道0； 'd1：通道1； ...... 'd30：通道30； 'd31：通道31； </description>
                                <bitOffset>11</bitOffset>
                                <bitWidth>5</bitWidth>
                                <access>read-write</access>
                                <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                            </field>
                            

                            <field>
                                <name>SARC_VC_SPLTIME</name>
                                <description> VCx的捕获预设。控制S/H增加的采样时间，支持0-256个ADCCLK周期数可配置。 实际的采样窗口总长度为：spltim+2.5UI </description>
                                <bitOffset>0</bitOffset>
                                <bitWidth>9</bitWidth>
                                <access>read-write</access>
                                <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                            </field>
                            

                        </fields>
                    </register>
                     
                </cluster>
                


                <register>
                    <name>VC_STATUS</name>
                    <description>VC_STATUS</description>
                    <addressOffset>0x0074</addressOffset>
                    <size>32</size>
                    <access>
                        read-only
                    </access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0xFFFFFFFF</resetMask>
                    <fields>
                        

                        <field>
                            <name>SARC_VC_STATUS</name>
                            <description> VC的状态指示。每2bit表示1个VC的状态，16个VC共需要32bit。 'b 00：idle； 'b 01：pending；当前VC处理排队等待状态。 'b 10：busy； 'b 11：无效状态RESERVED； </description>
                            <bitOffset>0</bitOffset>
                            <bitWidth>32</bitWidth>
                            <access>read-only</access>
                        </field>
                        

                    </fields>
                </register>
                


                <register>
                    <name>VC_FLAG</name>
                    <description>VC_FLAG</description>
                    <addressOffset>0x0078</addressOffset>
                    <size>32</size>
                    <access>
                        read-only
                    </access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0x0000FFFF</resetMask>
                    <fields>
                        

                        <field>
                            <name>SARC_VC_FLAG</name>
                            <description> VCx待转换标志，在VC开始转换（start信号的上升沿）时硬件clear。 在同一cycle，如果set和clear同时有效，则响应set，因此ADC_VC_OVF寄存器的对应bit位不受影响。 </description>
                            <bitOffset>0</bitOffset>
                            <bitWidth>16</bitWidth>
                            <access>read-only</access>
                        </field>
                        

                    </fields>
                </register>
                


                <register>
                    <name>VC_FORCE</name>
                    <description>VC_FORCE</description>
                    <addressOffset>0x007C</addressOffset>
                    <size>32</size>
                    <access>
                        read-write
                    </access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0x0000FFFF</resetMask>
                    <fields>
                        

                        <field>
                            <name>SARC_VC_FORCE</name>
                            <description> VCx强制转换开始标志。该位写1会强制将ADC_VC_FLG寄存器的对应位置1，用于软件控制启动转换。该位写0无效，该位读返回为0。 在同一cycle，如果软件set此位，同时硬件clear ADC_VC_FLG寄存器的对应位，则ADC_VC_FLG寄存器对应位响应set，此时ADC_VC_OVF寄存器的对应bit位不受影响。 </description>
                            <bitOffset>0</bitOffset>
                            <bitWidth>16</bitWidth>
                            <access>write-only</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                    </fields>
                </register>
                


                <register>
                    <name>VC_OVF</name>
                    <description>VC_OVF</description>
                    <addressOffset>0x0080</addressOffset>
                    <size>32</size>
                    <access>
                        read-only
                    </access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0x0000FFFF</resetMask>
                    <fields>
                        

                        <field>
                            <name>SARC_VC_OVF</name>
                            <description> VCx转换溢出标志。指示VCx是否发生转换溢出事件。即当VCx正有待转换事件时，硬件又产生下一个转换事件。 该溢出指示不影响转换事件的处理，仅指明硬件触发的丢失。软件控制的ADC_VC_FRC对应位不影响该溢出标志位的值。 </description>
                            <bitOffset>0</bitOffset>
                            <bitWidth>16</bitWidth>
                            <access>read-only</access>
                        </field>
                        

                    </fields>
                </register>
                


                <register>
                    <name>VC_OVF_CLR</name>
                    <description>VC_OVF_CLR</description>
                    <addressOffset>0x0084</addressOffset>
                    <size>32</size>
                    <access>
                        read-write
                    </access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0x0000FFFF</resetMask>
                    <fields>
                        

                        <field>
                            <name>SARC_VC_OVF_CLR</name>
                            <description> VCx清除转换溢出标志。 该位写1清除ADC_VC_OVF中对应位的溢出标志，该位写0无效。该位读返回0。 当软件置1该位的操作，与硬件置1 ADC_VC_OVF寄存器中的对应位的操作在同一个cycle发生时，硬件优先级高，即ADC_VC_OVF寄存器对应位会被置1。 </description>
                            <bitOffset>0</bitOffset>
                            <bitWidth>16</bitWidth>
                            <access>write-only</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                    </fields>
                </register>
                


                <register>
                    <name>T2S_FR_CNT</name>
                    <description>T2S_FR_CNT</description>
                    <addressOffset>0x0088</addressOffset>
                    <size>32</size>
                    <access>
                        read-only
                    </access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0x00000FFF</resetMask>
                    <fields>
                        

                        <field>
                            <name>T2S_FR_CNT</name>
                            <description> FREE-RUN计数器，当cfg_sarc_en有效时计数。该计数器用于trig-to-sample的延时捕获计数。 </description>
                            <bitOffset>0</bitOffset>
                            <bitWidth>12</bitWidth>
                            <access>read-only</access>
                        </field>
                        

                    </fields>
                </register>
                


                <cluster>
                    <dim>16</dim>
                    <dimIncrement>0x0008</dimIncrement>
                    <name>T2S_STAMP[%s]</name>
                    <description>T2S_STAMP</description>
                    <addressOffset>0x008C</addressOffset>
                    


                    <register>
                        <name>REQ</name>
                        <description>REQ</description>
                        <addressOffset>0x0</addressOffset>
                        <size>32</size>
                        <access>
                        read-only
                    </access>
                        <resetValue>0x00000000</resetValue>
                        <resetMask>0x00000FFF</resetMask>
                        <fields>
                            

                            <field>
                                <name>REQSTAMP</name>
                                <description> 采样触发到达时刻的时间戳，在采样触发到达时刻锁存FR_CNT计数值。 </description>
                                <bitOffset>0</bitOffset>
                                <bitWidth>12</bitWidth>
                                <access>read-only</access>
                            </field>
                            

                        </fields>
                    </register>
                    


                    <register>
                        <name>DLY</name>
                        <description>DLY</description>
                        <addressOffset>0x4</addressOffset>
                        <size>32</size>
                        <access>
                        read-only
                    </access>
                        <resetValue>0x00000000</resetValue>
                        <resetMask>0x00000FFF</resetMask>
                        <fields>
                            

                            <field>
                                <name>DLYSTAMP</name>
                                <description> trig-to-sample的延时时间戳。 使用采样开始时刻（S/H窗口上升沿）FR_CNT的计数值，减去采样触发时刻的时间戳reqstamp。 注意：FR_CNT最大计数为4096，当trig-to-sample的延时超过4096时，该dlystamp上报值可能是错误值，应用时要避免该情况出现。 </description>
                                <bitOffset>0</bitOffset>
                                <bitWidth>12</bitWidth>
                                <access>read-only</access>
                            </field>
                            

                        </fields>
                    </register>
                     
                </cluster>
                


                <register>
                    <name>PRE_OS_EN</name>
                    <description>PRE_OS_EN</description>
                    <addressOffset>0x010C</addressOffset>
                    <size>32</size>
                    <access>
                        read-write
                    </access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0x0000FFFF</resetMask>
                    <fields>
                        

                        <field>
                            <name>SARC_PRE_OS_EN</name>
                            <description> 预处理阶段offset系数使能模块。bit15-0对应vc15-0。 'b 0：预处理阶段offset校正关闭。 'b 1：预处理阶段offset校正打开。 </description>
                            <bitOffset>0</bitOffset>
                            <bitWidth>16</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                    </fields>
                </register>
                


                <cluster>
                    <dim>16</dim>
                    <dimIncrement>0x0004</dimIncrement>
                    <name>PRE_OS[%s]</name>
                    <description>CFG_SARC_PRE_OS</description>
                    <addressOffset>0x0110</addressOffset>
                    


                    <register>
                        <name>PRE_OS</name>
                        <description>PRE_OS</description>
                        <addressOffset>0x0</addressOffset>
                        <size>32</size>
                        <access>
                        read-write
                    </access>
                        <resetValue>0x00000000</resetValue>
                        <resetMask>0x0000FFFF</resetMask>
                        <fields>
                            

