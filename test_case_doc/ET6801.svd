                <register>
                    <name>EFC_CTRL</name>
                    <description>EFC_CTRL</description>
                    <addressOffset>0x0040</addressOffset>
                    <size>32</size>
                    <access>
                        read-write
                    </access>
                    <resetValue>0x60002000</resetValue>
                    <resetMask>0x71FF7FFE</resetMask>
                    <fields>
                        

                        <field>
                            <name>EFC_PERFNMR_EN</name>
                            <description> EFC数据总线读性能模式使能； 0：数据总线读等待FLASH时钟上升沿进入读状态； 1：数据总线读提前FLASH时钟上升沿两个EFC时钟周期进入读状态； </description>
                            <bitOffset>30</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>EFC_AXIS_WR_DUMMYBVLD_EN</name>
                            <description> 数据总线写返回dummy bvlid使能； 0：数据总线写不返回dummy bvlid，数据写入FLASH之后再返回bvlid； 1：数据总线写命令接收后直接返回dummy bvlid； </description>
                            <bitOffset>29</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>EFC_VREAD0_CHK_EN</name>
                            <description> AXI/APB总线对FLASH编程后自动VRAD0读CHECK使能 0: 不进行VRAD0读CHECK； 1: 进行VRAD0读CHECK； </description>
                            <bitOffset>28</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>EFC_RETRY_MIN</name>
                            <description> 配置Flash retry擦除的最少次数； </description>
                            <bitOffset>20</bitOffset>
                            <bitWidth>5</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>EFC_READMODE_DEBUG_EN</name>
                            <description> AXI读FLASH替换为VREAD0/1、SREAD0/1读使能； 4'b0000: AXI读不进行替换，AXI为Normal READ； 4'b0001: AXI读替换为VREAD0； 4'b0010: AXI读替换为VREAD1； 4'b0100: AXI读替换为SREAD0； 4'b1000: AXI读替换为SREAD1； others: AXI读不进行替换 </description>
                            <bitOffset>16</bitOffset>
                            <bitWidth>4</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>EFC_WRITE_SEL</name>
                            <description> FLASH写36bit选择； 0:写低36bit有效数据，高36bit写全1； 1:写高36bit有效数据，低36bit写全1； 注：，cfg_efc_write_full配置为0，硬件一次写36bit有效数据时有效，并且软件对应为AXI 8Bytes地址的低36bits； </description>
                            <bitOffset>14</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>EFC_WRITE_FULL</name>
                            <description> FLASH全写72bit使能； 0：硬件一次写36bit有效数据，另外36bit写全1； 1: 硬件一次性写72bit有效数据； </description>
                            <bitOffset>13</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>EFC_WRITE_EN</name>
                            <description> 配置EFC允许对Flash（Main / Redundancy）进行写/擦除操作； 0: 不允许对Flash进行写/擦除操作； 1: 允许对Flash进行写/擦除操作； </description>
                            <bitOffset>12</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>EFC_APBS_PWROFF_BUSERR_EN</name>
                            <description> 配置总线错误产生使能； 0: 在Flash未工作时的后续操作，APB总线不反馈Error Resp； 1: 在Flash未工作时的后续操作，APB总线反馈Error Resp； </description>
                            <bitOffset>11</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>EFC_APBS_EFCNWORK_BUSERR_EN</name>
                            <description> 配置总线错误产生使能； 0: 在EFC未工作时的后续操作，APB总线不反馈Error Resp； 1: 在EFC未工作时的后续操作，APB总线反馈Error Resp； </description>
                            <bitOffset>10</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>EFC_APBS_ECC2B_BUSERR_EN</name>
                            <description> 配置总线错误产生使能； 0: 在EFC未工作时的后续操作，APB总线不反馈Error Resp； 1: 在EFC未工作时的后续操作，APB总线反馈Error Resp； </description>
                            <bitOffset>9</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>EFC_APBS_WPT_BUSERR_EN</name>
                            <description> 配置总线错误产生使能； 0: 在发生wrp错误时，APB总线不反馈Error Resp； 1: 发生wrp错误时，APB总线反馈Error Resp； </description>
                            <bitOffset>8</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>EFC_APBS_PGS_BUSERR_EN</name>
                            <description> 配置总线错误产生使能； 0: 在发生pgs错误时，APB总线不反馈Error Resp； 1: 发生pgs错误时，APB总线反馈Error Resp； </description>
                            <bitOffset>7</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>EFC_APBS_INC_BUSERR_EN</name>
                            <description> 配置总线错误产生使能； 0: 在发生inc错误时，APB总线不反馈Error Resp； 1: 发生inc错误时，APB总线反馈Error Resp； </description>
                            <bitOffset>6</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>EFC_AXIS_PWROFF_BUSERR_EN</name>
                            <description> 数据总线错误产生使能； 0: 在Flash未工作时的后续操作，AXI总线不反馈Error Resp； 1: 在Flash未工作时的后续操作，AXI总线反馈Error Resp； </description>
                            <bitOffset>5</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>EFC_AXIS_EFCNWORK_BUSERR_EN</name>
                            <description> 数据总线错误产生使能； 0: 在EFC未工作时的后续操作，AXI总线不反馈Error Resp； 1: 在EFC未工作时的后续操作，AXI总线反馈Error Resp； </description>
                            <bitOffset>4</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>EFC_AXIS_ECC2B_BUSERR_EN</name>
                            <description> 数据总线错误产生使能； 0: 在EFC未工作时的后续操作，AXI总线不反馈Error Resp； 1: 在EFC未工作时的后续操作，AXI总线反馈Error Resp； </description>
                            <bitOffset>3</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
