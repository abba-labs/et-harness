                        <field>
                            <name>CFG2CAP_QCLM</name>
                            <description> cap计数值锁存模式 0：cpu读取锁存； 1：超时锁存； </description>
                            <bitOffset>2</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>CFG2UT_EN</name>
                            <description> 计时器使能 0：不使能 1：使能 </description>
                            <bitOffset>1</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
