                    <addressOffset>0x00AC</addressOffset>
                    <size>32</size>
                    <access>
                        read-write
                    </access>
                    <resetValue>0x00000001</resetValue>
                    <resetMask>0x00000031</resetMask>
                    <fields>
                        

                        <field>
                            <name>MST_WAKEUP_TIME</name>
                            <description> 发起唤醒信号时间配置，总线检测到wakeup_time时间的唤醒信号，置起wakeup_flag中断，上报软件。 00-250us; 01-500us; 10-2ms; 11-5ms </description>
                            <bitOffset>4</bitOffset>
                            <bitWidth>2</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>WAKEUP_EN</name>
                            <description> 接收到或者发出有效wakeup_flag后，软件配置wakeup_en决定唤醒请求是否有效 0：无效唤醒请求 1：有效唤醒请求 </description>
                            <bitOffset>0</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                    </fields>
                </register>
                


                <register>
                    <name>TIMEOUT</name>
                    <description>TIMEOUT</description>
                    <addressOffset>0x00B0</addressOffset>
                    <size>32</size>
                    <access>
                        read-write
                    </access>
                    <resetValue>0x00000001</resetValue>
                    <resetMask>0x00000031</resetMask>
                    <fields>
                        

                        <field>
                            <name>TIMEOUT_VAL</name>
                            <description> 超时时间配置，对于主节点超时发生在没有slave响应、slave响应太迟或者响应在最大帧时隙未完成等情况下。对于从节点超时发生在接收帧头后且该响应时，软件长时间未置起rsp_req，或者slave发出有效唤醒信号后，在150ms内未接收到主节点的帧头。 00-100 bit; 01-120 bit; 10-150 bit; 11-200 bit </description>
                            <bitOffset>4</bitOffset>
                            <bitWidth>2</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>TIMEOUT_EN</name>
                            <description> 超时检测使能 0：禁用超时检测功能 1：启用超时检测功能 </description>
                            <bitOffset>0</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                    </fields>
                </register>
                


                <register>
                    <name>LOOP_TEST</name>
                    <description>LOOP_TEST</description>
                    <addressOffset>0x00B4</addressOffset>
                    <size>32</size>
                    <access>
                        read-write
