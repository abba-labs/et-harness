                            <bitOffset>6</bitOffset>
                            
                
                            <bitWidth>1</bitWidth>
                            
                
                            <access>read-write</access>
                            
                
                            <modifiedWriteValues/>
                            
            
                        </field>
                        
            
                        <field>
                            
                
                            <name>SP</name>
                            
                
                            <description>writeable only when UART is not busy (USR[0] is 0); </description>
                            
                
                            <bitOffset>5</bitOffset>
                            
                
                            <bitWidth>1</bitWidth>
                            
                
                            <access>read-write</access>
                            
                
                            <modifiedWriteValues/>
                            
            
                        </field>
                        
            
                        <field>
                            
                
                            <name>EPS</name>
                            
                
                            <description>writeable only when UART is not busy (USR[0] is zero), otherwise always writable and always readable.</description>
                            
                
                            <bitOffset>4</bitOffset>
                            
                
                            <bitWidth>1</bitWidth>
                            
                
                            <access>read-write</access>
                            
                
                            <modifiedWriteValues/>
                            
            
                        </field>
                        
            
                        <field>
                            
                
                            <name>PEN</name>
                            
                
                            <description>writeable only when UART is not busy (USR[0] is zero), otherwise always writable and always readable.</description>
                            
                
                            <bitOffset>3</bitOffset>
                            
                
                            <bitWidth>1</bitWidth>
                            
                
                            <access>read-write</access>
                            
                
                            <modifiedWriteValues/>
                            
            
                        </field>
                        
            
                        <field>
                            
                
                            <name>STOP</name>
                            
                
                            <description>writeable only when UART is not busy (USR[0] is zero), otherwise always writable and always readable. </description>
                            
                
                            <bitOffset>2</bitOffset>
                            
                
                            <bitWidth>1</bitWidth>
                            
                
                            <access>read-write</access>
                            
                
                            <modifiedWriteValues/>
                            
            
