                            <bitOffset>4</bitOffset>
                            <bitWidth>2</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>EFC_ECC_ERRGEN_EN</name>
                            <description> ECC错误注入使能 1'b0：不打开ECC错误注入； 1'b1：打开ECC错误注入； </description>
                            <bitOffset>3</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>EFC_MAIN_ECC_EN</name>
                            <description> Main空间ECC功能使能开关； 0: ECC功能不使能； 1: ECC功能使能； Note：当使能注错功能时，对应注错地址需要先进行打开ecc使能后编程初始化，以确保注错地址本身存储的数据是ecc正确，否则上报的注错地址，不确定是其本身存储的数据ecc错误上报，还是注错导致的ecc错误地址上报；或者同时开启ECC读写翻转 </description>
                            <bitOffset>2</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

