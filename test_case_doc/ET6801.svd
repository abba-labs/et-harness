                        </modifiedWriteValues>
                            </field>
                            

                            <field>
                                <name>FPP_BLK_DLY_EN</name>
                                <description> 异常预处理blanking信号是否延迟使能。 0：不使能； 1：使能。 </description>
                                <bitOffset>4</bitOffset>
                                <bitWidth>1</bitWidth>
                                <access>read-write</access>
                                <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                            </field>
                            

                            <field>
                                <name>FPP_BLK_MD</name>
                                <description> 异常预处理 blanking time模式配置。 00: 没有blanking； 01：正常blanking； 10：延迟blanking； 11：预留。 </description>
                                <bitOffset>2</bitOffset>
                                <bitWidth>2</bitWidth>
