                                <bitOffset>20</bitOffset>
                                <bitWidth>12</bitWidth>
                                <access>read-write</access>
                                <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                            </field>
                            

                            <field>
                                <name>DSI</name>
                                <description> Destination Scatter Interval. </description>
                                <bitOffset>0</bitOffset>
                                <bitWidth>20</bitWidth>
                                <access>read-write</access>
                                <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                            </field>
                            

                        </fields>
