                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>EFC_READMODE_DEBUG_EN</name>
                            <description> AXI读FLASH替换为VREAD0/1、SREAD0/1读使能； 4'b0000: AXI读不进行替换，AXI为Normal READ； 4'b0001: AXI读替换为VREAD0； 4'b0010: AXI读替换为VREAD1； 4'b0100: AXI读替换为SREAD0； 4'b1000: AXI读替换为SREAD1； others: AXI读不进行替换 </description>
                            <bitOffset>16</bitOffset>
                            <bitWidth>4</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>EFC_WRITE_SEL</name>
                            <description> FLASH写36bit选择； 0:写低36bit有效数据，高36bit写全1； 1:写高36bit有效数据，低36bit写全1； 注：，cfg_efc_write_full配置为0，硬件一次写36bit有效数据时有效，并且软件对应为AXI 8Bytes地址的低36bits； </description>
                            <bitOffset>14</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>EFC_WRITE_FULL</name>
                            <description> FLASH全写72bit使能； 0：硬件一次写36bit有效数据，另外36bit写全1； 1: 硬件一次性写72bit有效数据； </description>
                            <bitOffset>13</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>EFC_WRITE_EN</name>
                            <description> 配置EFC允许对Flash（Main / Redundancy）进行写/擦除操作； 0: 不允许对Flash进行写/擦除操作； 1: 允许对Flash进行写/擦除操作； </description>
                            <bitOffset>12</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>EFC_APBS_PWROFF_BUSERR_EN</name>
