                                <bitOffset>0</bitOffset>
                                <bitWidth>20</bitWidth>
                                <access>read-write</access>
                                <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                            </field>
                            

                        </fields>
                    </register>
                     


                    <register>
