                    <fields>
                        

                        <field>
                            <name>HW_HOLD_IND</name>
                            <description> DAC输出保持状态； 'b0：DAC输出正常，根据DAC配置进行输出； 'b1：DAC输出保持不变；软复位重新启动，APP程序需要根据软硬件hold_ind判断是否进行重新配置DAC参数，以及对hold_ind进行清零；软件写1清。 </description>
                            <bitOffset>4</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>HW_HOLD_MASK</name>
                            <description> DACC硬件保持屏蔽信号； 'b0：DACC硬件保持屏蔽功能关闭； 'b1：DACC硬件保持屏蔽功能打开； 受sysc_nv_lock寄存器锁定； </description>
                            <bitOffset>2</bitOffset>
                            <bitWidth>2</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>SW_HOLD_EN</name>
                            <description> DACC软件强制保持使能； 'b0：DACC软件强制保持使能关闭； 'b1：DACC软件强制保持使能打开； 受sysc_nv_lock寄存器锁定； </description>
                            <bitOffset>0</bitOffset>
                            <bitWidth>2</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                    </fields>
