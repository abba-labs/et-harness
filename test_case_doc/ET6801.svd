                    <size>32</size>
                    <access>
                        read-write
                    </access>
                    <resetValue>0x60002000</resetValue>
                    <resetMask>0x71FF7FFF</resetMask>
                    <fields>
                        

                        <field>
                            <name>EFC_PERFNMR_EN</name>
                            <description> EFC数据总线读性能模式使能； 0：数据总线读等待FLASH时钟上升沿进入读状态； 1：数据总线读提前FLASH时钟上升沿两个EFC时钟周期进入读状态； </description>
                            <bitOffset>30</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>EFC_AXIS_WR_DUMMYBVLD_EN</name>
