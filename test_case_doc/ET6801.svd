                        <addressOffset>0x0</addressOffset>
                        <size>32</size>
                        <access>
                        read-write
                    </access>
                        <resetValue>0x00000000</resetValue>
                        <resetMask>0x00003737</resetMask>
                        <fields>
                            

                            <field>
                                <name>DB_S3B</name>
                                <description> 死区b支路第3个MUX的输出选择 'd0，'d3：选择不做任何延迟的，旁路输出，即选择DB模块输入的b支路PWM信号作为输出； 'b 01：选择b支路第2个MUX的输出。 'b 10：选择将b支路第2个MUX的输出取反后再输出。 </description>
                                <bitOffset>12</bitOffset>
                                <bitWidth>2</bitWidth>
                                <access>read-write</access>
                                <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                            </field>
                            

                            <field>
                                <name>DB_S2B</name>
                                <description> 死区b支路第2个MUX的输出选择 'b 0：选择b支路第1个MUX的输出； 'b 1：选择将b支路第1个MUX的输出进行下降沿延迟处理之后作为第2个MUX的输出。 </description>
                                <bitOffset>10</bitOffset>
                                <bitWidth>1</bitWidth>
                                <access>read-write</access>
                                <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                            </field>
                            

                            <field>
                                <name>DB_S1B</name>
                                <description> 死区b支路第1个MUX的输出选择 'b 0：选择将b支路第0个MUX的输出； 'b 1：选择将b支路第0个MUX的输出进行上升沿延迟处理之后作为第1个MUX的输出 </description>
                                <bitOffset>9</bitOffset>
                                <bitWidth>1</bitWidth>
                                <access>read-write</access>
                                <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                            </field>
                            

                            <field>
                                <name>DB_S0B</name>
                                <description> 死区b支路第0个MUX的输出选择。 'b 0：选择选择DB模块输入的b支路PWM信号，即srpwmb信号； 'b 1：选择DB模块输入的a支路PWM信号，即srpwma信号。 </description>
                                <bitOffset>8</bitOffset>
                                <bitWidth>1</bitWidth>
                                <access>read-write</access>
                                <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                            </field>
                            

                            <field>
                                <name>DB_S3A</name>
                                <description> 死区a支路第3个MUX选择 'b 00，'b11：选择不做任何延迟的，旁路输出，即选择DB模块输入的b支路PWM信号作为输出； 'b 01：选择b支路第2个MUX的输出。 'b 10：选择将b支路第2个MUX的输出取反后再输出。 </description>
                                <bitOffset>4</bitOffset>
                                <bitWidth>2</bitWidth>
                                <access>read-write</access>
                                <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                            </field>
                            

                            <field>
                                <name>DB_S2A</name>
                                <description> 死区a支路第2个MUX选择 'b 0：选择a支路第1个MUX的输出； 'b 1：选择将a支路第1个MUX的输出进行下降沿延迟处理之后作为第2个MUX的输出。 </description>
                                <bitOffset>2</bitOffset>
                                <bitWidth>1</bitWidth>
                                <access>read-write</access>
                                <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                            </field>
                            

