                            <bitOffset>1</bitOffset>
                            
                        
                            <bitWidth>31</bitWidth>
                            
                        
                            <access>read-only</access>
                            
                    
                        </field>
                        
                    
                        <field>
                            
                        
                            <name>CLR_TX_ABRT</name>
                            
                        
                            <description> Read this register to clear the TX_ABRT interrupt (bit 6) of 
                  the IC_RAW_INTR_STAT register, and the 
                  IC_TX_ABRT_SOURCE register. This also releases the TX 
                  FIFO from the flushed/reset state, allowing more writes to 
                  the TX FIFO.</description>
                            
                        
                            <bitOffset>0</bitOffset>
                            
                        
                            <bitWidth>1</bitWidth>
                            
                        
                            <access>read-only</access>
                            
                    
                        </field>
                        
                
                    </fields>
                    
            
                </register>
                
            
