                            <name>DLAB</name>
                            
                
                            <description>Divisor Latch Access Bit.This bit is used to enable reading and writing of the Divisor Latch register (DLL and DLH/LPDLL and LPDLH) to set the baud rate of the UART.</description>
                            
                
                            <bitOffset>7</bitOffset>
                            
                
                            <bitWidth>1</bitWidth>
                            
                
