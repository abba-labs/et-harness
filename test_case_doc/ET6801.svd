                    <resetValue>0x00000000</resetValue>
                    <resetMask>0x00000001</resetMask>
                    <fields>
                        

                        <field>
                            <name>LOOP_TEST_EN</name>
                            <description> 环回测试使能，IP内部环回(rx,tx短接)，注意此时gpio的rx、tx均需要断开(OEN不使能)，为了不影响总线的正常通信。 0：禁用环回测试功能 1：使能环回测试功能 </description>
                            <bitOffset>0</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                    </fields>
                </register>
                


