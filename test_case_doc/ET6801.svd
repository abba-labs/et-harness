                    <description>FIFO_CTRL</description>
                    <addressOffset>0x023C</addressOffset>
                    <size>32</size>
                    <access>
                        read-write
                    </access>
                    <resetValue>0x00100010</resetValue>
                    <resetMask>0x011F011F</resetMask>
                    <fields>
                        

                        <field>
                            <name>FIL_FIFO_BITMAP_RELOAD</name>
                            <description> ADC采样值滤波后上报结果采用fifo模式读取时，fifo读数据地址重新加载指示信号。在软件初始化或者重新配置vc_en/fifo_vc_sel后，需要向该bit位写1。 'b0：重新加载指示无效 'b1：重新加载指示有效 </description>
                            <bitOffset>24</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>write-only</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>FIL_FIFO_DEPTH</name>
                            <description> ADC采样值滤波后上报结果采用fifo模式读取时，fifo的深度配置： 'd0：fifo深度为0，无效配置 'd1：fifo深度为1 'd2：fifo深度为2 ... 'd16：fifo深度为16 其它：无效配置 </description>
                            <bitOffset>16</bitOffset>
                            <bitWidth>5</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>PRE_FIFO_BITMAP_RELOAD</name>
                            <description> ADC采样值用户预处理后上报结果采用fifo模式读取时，fifo读数据地址重新加载指示信号。在软件初始化或者重新配置vc_en/fifo_vc_sel后，需要向该bit位写1。 'b0：重新加载指示无效 'b1：重新加载指示有效 </description>
                            <bitOffset>8</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>write-only</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>PRE_FIFO_DEPTH</name>
                            <description> ADC采样值用户预处理后上报结果采用fifo模式读取时，fifo的深度配置： 'd0：fifo深度为0，无效配置 'd1：fifo深度为1 'd2：fifo深度为2 ... 'd16：fifo深度为16 其它：无效配置 </description>
                            <bitOffset>0</bitOffset>
                            <bitWidth>5</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                    </fields>
                </register>
                


                <register>
                    <name>FIFO_VC_SEL</name>
                    <description>FIFO_VC_SEL</description>
                    <addressOffset>0x0240</addressOffset>
                    <size>32</size>
                    <access>
                        read-write
                    </access>
                    <resetValue>0xFFFFFFFF</resetValue>
                    <resetMask>0xFFFFFFFF</resetMask>
                    <fields>
                        

                        <field>
                            <name>FIL_FIFO_VC_SEL</name>
                            <description> ADC采样值滤波后上报结果采用fifo模式读取时，fifo映射vc选择配置，默认为全1，该配置与cfg_vc_en相与后作为最终的映射关系。如果使能的vc都映射到fifo时，该寄存器可以使用默认配置： 'b0：对应vc不映射到fifo模式 'b1：对应vc映射到fifo模式 </description>
                            <bitOffset>16</bitOffset>
                            <bitWidth>16</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>PRE_FIFO_VC_SEL</name>
                            <description> ADC采样值用户预处理后上报结果采用fifo模式读取时，fifo映射vc选择配置，默认为全1，该配置与cfg_vc_en相与后作为最终的映射关系。如果使能的vc都映射到fifo时，该寄存器可以使用默认配置： 'b0：对应vc不映射到fifo模式 'b1：对应vc映射到fifo模式 </description>
                            <bitOffset>0</bitOffset>
                            <bitWidth>16</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                    </fields>
                </register>
                


                <register>
                    <name>FIL_FIFO_STS</name>
                    <description>FIL_FIFO_STS</description>
                    <addressOffset>0x0244</addressOffset>
                    <size>32</size>
                    <access>
                        read-only
                    </access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0xFFFFFFFF</resetMask>
                    <fields>
                        

                        <field>
                            <name>FIL_FIFO_STS</name>
                            <description> ADC采样值滤波后上报结果采用fifo模式读取时，fifo的状态上报指示： bit0：fifo_full （fifo满） bit1：fifo_empty（fifo空） bit2：fifo_full_ovf（fifo满溢出） bit3：fifo_empty_ovf（fifo空溢出） bit4-bit8：fifo_data_cnt（fifo数据个数） 其它bit：无效 </description>
                            <bitOffset>0</bitOffset>
                            <bitWidth>32</bitWidth>
                            <access>read-only</access>
                        </field>
                        

                    </fields>
                </register>
                


                <register>
                    <name>PRE_FIFO_STS</name>
                    <description>PRE_FIFO_STS</description>
                    <addressOffset>0x0248</addressOffset>
                    <size>32</size>
                    <access>
                        read-only
                    </access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0xFFFFFFFF</resetMask>
                    <fields>
                        

                        <field>
                            <name>PRE_FIFO_STS</name>
                            <description> ADC采样值用户预处理后上报结果采用fifo模式读取时，fifo的状态上报指示： bit0：fifo_full （fifo满） bit1：fifo_empty（fifo空） bit2：fifo_full_ovf（fifo满溢出） bit3：fifo_empty_ovf（fifo空溢出） bit4-bit8：fifo_data_cnt（fifo数据个数） 其它bit：无效 </description>
                            <bitOffset>0</bitOffset>
                            <bitWidth>32</bitWidth>
                            <access>read-only</access>
                        </field>
                        

                    </fields>
                </register>
                


                <register>
                    <name>FIL_FIFO_DATA</name>
                    <description>FIL_FIFO_DATA</description>
                    <addressOffset>0x024C</addressOffset>
                    <size>32</size>
                    <access>
                        read-only
                    </access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0xFFFFFFFF</resetMask>
                    <fields>
                        

                        <field>
                            <name>FIL_FIFO_DATA</name>
                            <description> ADC采样值滤波后上报结果采用fifo模式读取时，fifo的数据上报： bit0-bit15：采样结果 bit16：采样结果val值 bit17：采样结果ovf值 bit18-bit21：采样结果对应的vc编号 其它bit：无效 </description>
                            <bitOffset>0</bitOffset>
                            <bitWidth>32</bitWidth>
                            <access>read-only</access>
                        </field>
                        

                    </fields>
                </register>
                


                <register>
                    <name>PRE_FIFO_DATA</name>
                    <description>PRE_FIFO_DATA</description>
                    <addressOffset>0x0250</addressOffset>
                    <size>32</size>
                    <access>
                        read-only
                    </access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0xFFFFFFFF</resetMask>
                    <fields>
                        

                        <field>
                            <name>PRE_FIFO_DATA</name>
                            <description> ADC采样值用户预处理后上报结果采用fifo模式读取时，fifo的数据上报： bit0-bit15：采样结果 bit16：采样结果val值 bit17：采样结果ovf值 bit18-bit21：采样结果对应的vc编号 其它bit：无效 </description>
                            <bitOffset>0</bitOffset>
                            <bitWidth>32</bitWidth>
                            <access>read-only</access>
                        </field>
                        

                    </fields>
                </register>
                


                <cluster>
                    <dim>16</dim>
                    <dimIncrement>0x0004</dimIncrement>
                    <name>PRE_RESULT[%s]</name>
                    <description>PRE_RESULT</description>
                    <addressOffset>0x0254</addressOffset>
                    


                    <register>
                        <name>PRE</name>
                        <description>PRE</description>
                        <addressOffset>0x0</addressOffset>
                        <size>32</size>
                        <access>
                        read-write
                    </access>
                        <resetValue>0x00000000</resetValue>
                        <resetMask>0x0003FFFF</resetMask>
                        <fields>
                            

                            <field>
                                <name>PRE_RESULT_OVF</name>
                                <description> VC采样结果寄存器有数据溢出指示。读清零。 每次有采样数据到达到，如果adc_result_val信号为高，则产生溢出指示。 </description>
                                <bitOffset>17</bitOffset>
                                <bitWidth>1</bitWidth>
                                <access>read-write</access>
                                <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                            </field>
                            

                            <field>
                                <name>PRE_RESULT_VAL</name>
                                <description> VC采样结果寄存器有数据指示。读清零。 每次该VC有采样数据，val信号置高。CPU或DMA读走后，置低。 </description>
                                <bitOffset>16</bitOffset>
                                <bitWidth>1</bitWidth>
                                <access>read-write</access>
                                <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                            </field>
                            

                            <field>
                                <name>PRE_RESULT</name>
                                <description> VC采样结果寄存器，s(15,0) (最高2位[15:14]均为符号位)或者s(16,2) </description>
                                <bitOffset>0</bitOffset>
                                <bitWidth>16</bitWidth>
                                <access>read-only</access>
                            </field>
                            

                        </fields>
                    </register>
                     
                </cluster>
                


                <cluster>
                    <dim>16</dim>
                    <dimIncrement>0x0004</dimIncrement>
                    <name>FIL_RESULT[%s]</name>
                    <description>FIL_RESULT</description>
                    <addressOffset>0x0294</addressOffset>
                    


                    <register>
                        <name>FIL</name>
                        <description>FIL</description>
                        <addressOffset>0x0</addressOffset>
                        <size>32</size>
                        <access>
                        read-write
                    </access>
                        <resetValue>0x00000000</resetValue>
                        <resetMask>0x0003FFFF</resetMask>
                        <fields>
                            

                            <field>
                                <name>FIL_RESULT_OVF</name>
                                <description> VC采样结果寄存器有数据溢出指示。读清零。 每次有采样数据到达到，如果adc_result_val信号为高，则产生溢出指示。 </description>
                                <bitOffset>17</bitOffset>
                                <bitWidth>1</bitWidth>
                                <access>read-write</access>
                                <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                            </field>
                            

                            <field>
                                <name>FIL_RESULT_VAL</name>
                                <description> VC采样结果寄存器有数据指示。读清零。 每次该VC有采样数据，val信号置高。CPU或DMA读走后，置低。 </description>
                                <bitOffset>16</bitOffset>
                                <bitWidth>1</bitWidth>
                                <access>read-write</access>
                                <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                            </field>
                            

                            <field>
                                <name>FIL_RESULT</name>
                                <description> VC采样结果寄存器，u(12,0)或者s(16,2) </description>
                                <bitOffset>0</bitOffset>
                                <bitWidth>16</bitWidth>
                                <access>read-only</access>
                            </field>
                            

                        </fields>
                    </register>
                     
                </cluster>
                


                <register>
                    <name>DMA_CTL</name>
                    <description>DMA_CTL</description>
                    <addressOffset>0x02D4</addressOffset>
                    <size>32</size>
                    <access>
                        read-write
                    </access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0xFFFFFFF0</resetMask>
                    <fields>
                        

                        <field>
                            <name>SARC_DMA_CH_3</name>
                            <description> DMA通道3的选择。从64bit的DMA请求中选取1bit。 bit63-bit48：滤波后结果更新（vc15-vc0）； bit47-bit32：用户预处理后结果更新（vc15-vc0）； bit31-bit16：ADC超门限告警（超上下门限相或）（vc15-vc0）； bit15-bit0： ADC EOC（vc15-vc0）； </description>
                            <bitOffset>26</bitOffset>
                            <bitWidth>6</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>SARC_DMA_CH_2</name>
                            <description> DMA通道2的选择。从64bit的DMA请求中选取1bit。 bit63-bit48：滤波后结果更新（vc15-vc0）； bit47-bit32：用户预处理后结果更新（vc15-vc0）； bit31-bit16：ADC超门限告警（超上下门限相或）（vc15-vc0）； bit15-bit0： ADC EOC（vc15-vc0）； </description>
                            <bitOffset>20</bitOffset>
                            <bitWidth>6</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>SARC_DMA_CH_1</name>
                            <description> DMA通道1的选择。从64bit的DMA请求中选取1bit。 bit63-bit48：滤波后结果更新（vc15-vc0）； bit47-bit32：用户预处理后结果更新（vc15-vc0）； bit31-bit16：ADC超门限告警（超上下门限相或）（vc15-vc0）； bit15-bit0： ADC EOC（vc15-vc0）； </description>
                            <bitOffset>14</bitOffset>
                            <bitWidth>6</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>SARC_DMA_CH_0</name>
                            <description> DMA通道0的选择。从64bit的DMA请求中选取1bit。 bit63-bit48：滤波后结果更新（vc15-vc0）； bit47-bit32：用户预处理后结果更新（vc15-vc0）； bit31-bit16：ADC超门限告警（超上下门限相或）（vc15-vc0）； bit15-bit0： ADC EOC（vc15-vc0）； </description>
                            <bitOffset>8</bitOffset>
                            <bitWidth>6</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>SARC_DMA_HDSK_EN</name>
                            <description> 4个DMA通道的握手模块使能信号。 'b 0：不使能； 'b 1：使能； 该使能信号不使用，DMA的握手功能移到DMA_MUX模块中。 </description>
                            <bitOffset>4</bitOffset>
                            <bitWidth>4</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                    </fields>
                </register>
                


                <register>
                    <name>FIFO_DMA_CTL</name>
                    <description>FIFO_DMA_CTL</description>
                    <addressOffset>0x02D8</addressOffset>
                    <size>32</size>
                    <access>
                        read-write
                    </access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0x000000FF</resetMask>
                    <fields>
                        

                        <field>
                            <name>SARC_FIFO_DMA_EN_3</name>
                            <description> DMA通道3是否选择fifo请求使能配置 'b 0：不选择fifo请求，通道3的请求由CFG_SARC_DMA_CTL控制； 'b 1：选择fifo请求，由cfg_sarc_fifo_dma_ch_3选择相应的fifo请求； </description>
                            <bitOffset>7</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

                        <field>
                            <name>SARC_FIFO_DMA_CH_3</name>
