                            <description> Tx Event FIFO New Entry 0= Tx Event FIFO unchanged 1= Tx Handler wrote Tx Event FIFO element </description>
                            <bitOffset>12</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-write</access>
                            <modifiedWriteValues>
                            modify
                        </modifiedWriteValues>
                        </field>
                        

