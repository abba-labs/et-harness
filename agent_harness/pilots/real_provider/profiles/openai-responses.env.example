# Level 2C model-layer configuration example.
# Supply OPENAI_COMPAT_API_KEY separately through the process environment or secret manager.
OPENAI_COMPAT_BASE_URL=https://api.openai.com/v1
OPENAI_COMPAT_MODEL=<provider-model-id>
OPENAI_COMPAT_API_STYLE=responses
OPENAI_COMPAT_PROVIDER_ID=openai
REAL_PROVIDER_LANE=synthetic
